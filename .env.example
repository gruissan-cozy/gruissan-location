# Variables Supabase (gratuit : https://supabase.com)
# Copiez ce fichier en .env à la racine du projet et remplissez les valeurs.
# La clé "anon" est PUBLIQUE par conception (protégée par RLS côté base).
# Ne mettez JAMAIS la clé "service_role" ici.

PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
