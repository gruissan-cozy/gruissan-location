---
import '../styles/global.css';
import site from '../../content/site.json';
import { LANGUAGES, langNames, t, seo } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
  title: string;
}

const { lang = 'fr', title } = Astro.props as Props;
const tr = t[lang];
const year = new Date().getFullYear();
const href = (l: Lang) => `/gruissan-location/${l === 'fr' ? '' : l + '/'}`;

// --- SEO ---
const siteUrl = 'https://gruissan-cozy.github.io';
const pageUrl = `${siteUrl}/gruissan-location/${lang === 'fr' ? '' : lang + '/'}`;
const ogImage = `${siteUrl}/gruissan-location/images/hero.svg`;
const metaTitle = seo[lang].title;
const metaDesc = seo[lang].description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="fr" href={`${siteUrl}/gruissan-location/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/gruissan-location/en/`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/gruissan-location/es/`} />
    <link rel="alternate" hreflang="de" href={`${siteUrl}/gruissan-location/de/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/gruissan-location/`} />
    <link rel="icon" type="image/svg+xml" href="/gruissan-location/favicon.svg" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={seo[lang].ogLocale} />
    <meta property="og:site_name" content="Gruissan Cozy" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
    <!-- Données structurées schema.org (résultats enrichis Google) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LodgingBusiness',
      name: 'Gruissan Cozy',
      description: seo.fr.description,
      url: 'https://gruissan-cozy.github.io/gruissan-location/',
      telephone: site.telephone,
      email: site.email,
      image: ogImage,
      priceRange: '€€',
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.adresse_ligne,
        postalCode: site.code_postal,
        addressLocality: site.ville,
        addressRegion: site.region,
        addressCountry: 'FR',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.latitude,
        longitude: site.longitude,
      },
      numberOfRooms: site.chambres,
      occupancy: { '@type': 'QuantitativeValue', maxValue: site.capacite },
      amenityFeature: [
        'Wi-Fi', 'Parking', 'Climatisation', 'Terrasse', 'Lave-linge', 'Plage à proximité',
      ].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
      potentialAction: {
        '@type': 'ReserveAction',
        target: 'https://gruissan-cozy.github.io/gruissan-location/#contact',
      },
    })} />
  </head>
  <body class="bg-sand-50 text-ocean-900 font-sans antialiased">
    <!-- Header -->
    <header class="fixed top-0 inset-x-0 z-50 bg-sand-50/95 backdrop-blur-sm border-b border-sand-200/60 shadow-nav">
      <nav class="max-w-6xl mx-auto flex items-center justify-between px-4 h-16">
        <a href={href(lang)} class="flex items-center gap-2">
          <svg class="w-7 h-7" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#15648a"/>
            <path d="M8 44 Q20 36 32 42 T56 40 V56 H8 Z" fill="#a9d9ec"/>
            <circle cx="44" cy="20" r="8" fill="#e8926b"/>
          </svg>
          <span class="font-display text-xl font-semibold text-ocean-800">Gruissan Cozy</span>
        </a>
        <div class="hidden md:flex items-center gap-7 text-sm">
          <a href="#appart" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['nav.appart']}</a>
          <a href="#proxi" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['proxi.title']}</a>
          <a href="#galerie" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['nav.galerie']}</a>
          <a href="#tarifs" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['nav.tarifs']}</a>
          <a href="#dispo" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['nav.dispo']}</a>
        </div>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-1 text-xs" aria-label={tr['footer.langue']}>
            {LANGUAGES.map((l) => (
              <a
                href={href(l)}
                class:list={[
                  'px-1.5 py-1 rounded transition-colors',
                  l === lang
                    ? 'bg-ocean-600 text-white font-semibold'
                    : 'text-ocean-700/60 hover:text-ocean-600 hover:bg-ocean-50',
                ]}
                title={langNames[l]}
                aria-current={l === lang ? 'true' : undefined}
              >{l.toUpperCase()}</a>
            ))}
          </div>
          <a
            href="#contact"
            class="hidden md:inline-flex bg-sunset-500 hover:bg-sunset-600 text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors"
          >{tr['nav.contact']}</a>
        </div>
      </nav>
    </header>

    <main class="pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-ocean-900 text-ocean-100/80">
      <div class="max-w-6xl mx-auto px-4 py-14 grid md:grid-cols-3 gap-10 text-sm">
        <div>
          <p class="font-display text-xl font-semibold text-white mb-4">Gruissan Cozy</p>
          <p class="leading-relaxed">
            {site.adresse_ligne}<br />{site.code_postal} {site.ville}<br />{site.region}
          </p>
        </div>
        <div>
          <p class="font-semibold text-white mb-4">{tr['footer.contact']}</p>
          <p class="space-y-1">
            <a href={`tel:${site.telephone}`} class="hover:text-white transition-colors block">{site.telephone_display}</a>
            <a href={`mailto:${site.email}`} class="hover:text-white transition-colors block">{site.email}</a>
          </p>
        </div>
        <div>
          <p class="font-semibold text-white mb-4">{tr['footer.liens']}</p>
          <p class="flex flex-wrap gap-x-5 gap-y-2">
            {site.airbnb_url && <a href={site.airbnb_url} class="hover:text-white transition-colors">{tr['contact.airbnb']}</a>}
            {site.abritel_url && <a href={site.abritel_url} class="hover:text-white transition-colors">{tr['contact.abritel']}</a>}
            {site.instagram_url && <a href={site.instagram_url} class="hover:text-white transition-colors">{tr['contact.instagram']}</a>}
          </p>
        </div>
      </div>
      <div class="border-t border-ocean-800 py-5 text-center text-xs text-ocean-200/50">
        © {year} Gruissan Cozy · {tr['footer.rights']}
      </div>
    </footer>
  </body>
</html>
