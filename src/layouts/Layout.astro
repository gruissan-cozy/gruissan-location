---
import '../styles/global.css';
import site from '../../content/site.json';
import { LANGUAGES, langNames, t, seo } from '../i18n';
import type { Lang } from '../i18n';
import { libelleNumero, lienWhatsApp, numeroAppel, peutAppeler, peutUtiliserWhatsApp } from '../lib/contact';

interface Props {
  lang?: Lang;
  title: string;
}

const { lang = 'fr' } = Astro.props as Props;
const tr = t[lang];
const year = new Date().getFullYear();
const href = (l: Lang) => `/gruissan-location/${l === 'fr' ? '' : l + '/'}`;
// Lien vers le guide d'accueil dans la langue courante
const guideHref = `/gruissan-location/${lang === 'fr' ? '' : lang + '/'}guide/`;

// --- Contact direct : boutons masqués tant que content/site.json n'a pas de vraie coordonnée ---
const coordonnees = site;
const appelLien = numeroAppel(coordonnees.telephone);
const whatsappLien = lienWhatsApp(coordonnees.telephone, coordonnees.whatsapp);
const montrerAppel = peutAppeler(coordonnees);
const montrerWhatsApp = peutUtiliserWhatsApp(coordonnees);
const telephoneAffiche = libelleNumero(coordonnees);

// --- SEO ---
const siteUrl = 'https://gruissan-cozy.github.io';
const pageUrl = `${siteUrl}/gruissan-location/${lang === 'fr' ? '' : lang + '/'}`;
const ogImage = `${siteUrl}/gruissan-location/images/hero.svg`;
const metaTitle = seo[lang].title;
const metaDesc = seo[lang].description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="fr" href={`${siteUrl}/gruissan-location/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/gruissan-location/en/`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/gruissan-location/es/`} />
    <link rel="alternate" hreflang="de" href={`${siteUrl}/gruissan-location/de/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/gruissan-location/`} />
    <link rel="icon" type="image/svg+xml" href="/gruissan-location/favicon.svg" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={seo[lang].ogLocale} />
    <meta property="og:site_name" content="Gruissan Cozy" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
    <!-- Données structurées schema.org (résultats enrichis Google) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LodgingBusiness',
      name: 'Gruissan Cozy',
      description: seo.fr.description,
      url: 'https://gruissan-cozy.github.io/gruissan-location/',
      telephone: site.telephone,
      email: site.email,
      image: ogImage,
      priceRange: '€€',
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.adresse_ligne,
        postalCode: site.code_postal,
        addressLocality: site.ville,
        addressRegion: site.region,
        addressCountry: 'FR',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.latitude,
        longitude: site.longitude,
      },
      numberOfRooms: site.chambres,
      occupancy: { '@type': 'QuantitativeValue', maxValue: site.capacite },
      amenityFeature: [
        'Wi-Fi', 'Parking', 'Climatisation', 'Terrasse', 'Lave-linge', 'Plage à proximité',
      ].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
      potentialAction: {
        '@type': 'ReserveAction',
        target: 'https://gruissan-cozy.github.io/gruissan-location/#contact',
      },
    })} />
  </head>
  <body class="bg-sand-50 text-ocean-900 font-sans antialiased">
    <!-- Header -->
    <header class="fixed top-0 inset-x-0 z-50 bg-sand-50/95 backdrop-blur-sm border-b border-sand-200/60 shadow-nav">
      <nav class="max-w-6xl mx-auto flex items-center justify-between px-4 h-16">
        <a href={href(lang)} class="flex items-center gap-2">
          <svg class="w-7 h-7" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#15648a"/>
            <path d="M8 44 Q20 36 32 42 T56 40 V56 H8 Z" fill="#a9d9ec"/>
            <circle cx="44" cy="20" r="8" fill="#e8926b"/>
          </svg>
          <span class="font-display text-xl font-semibold text-ocean-800">Gruissan Cozy</span>
        </a>
        <div class="hidden md:flex items-center gap-7 text-sm">
          <a href="#appart" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['nav.appart']}</a>
          <a href="#proxi" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['proxi.title']}</a>
          <a href="#galerie" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['nav.galerie']}</a>
          <a href="#tarifs" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['nav.tarifs']}</a>
          <a href="#dispo" class="text-ocean-700/80 hover:text-ocean-600 transition-colors">{tr['nav.dispo']}</a>
          <a href={guideHref} class="text-sunset-600 hover:text-sunset-500 transition-colors font-medium">{tr['nav.guide']}</a>
          <a
            href={`/gruissan-location/${lang === 'fr' ? '' : lang + '/'}reserver/`}
            class="text-ocean-700/80 hover:text-ocean-600 transition-colors font-semibold"
          >{tr['nav.reserver']}</a>
        </div>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-1 text-xs" aria-label={tr['footer.langue']}>
            {LANGUAGES.map((l) => (
              <a
                href={href(l)}
                class:list={[
                  'px-1.5 py-1 rounded transition-colors',
                  l === lang
                    ? 'bg-ocean-600 text-white font-semibold'
                    : 'text-ocean-700/60 hover:text-ocean-600 hover:bg-ocean-50',
                ]}
                title={langNames[l]}
                aria-current={l === lang ? 'true' : undefined}
              >{l.toUpperCase()}</a>
            ))}
          </div>
          <!-- Contact direct en haut de page : masqué tant que les coordonnées sont vides -->
          {montrerAppel && appelLien && (
            <a
              href={appelLien}
              class="hidden md:inline-flex items-center gap-1.5 text-sm font-semibold text-ocean-700 hover:text-ocean-500 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ocean-400 rounded-full px-2 py-1"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              {libelleNumero(coordonnees)}
            </a>
          )}
          {montrerWhatsApp && whatsappLien && (
            <a
              href={whatsappLien}
              target="_blank"
              rel="noopener noreferrer"
              class="hidden md:inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 hover:text-emerald-600 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded-full px-2 py-1"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              WhatsApp
            </a>
          )}
          <a
            href="#contact"
            class="hidden md:inline-flex bg-sunset-500 hover:bg-sunset-600 text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors"
          >{tr['nav.contact']}</a>
        </div>
      </nav>
    </header>

    <main class="pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-ocean-900 text-ocean-100/80">
      <div class="max-w-6xl mx-auto px-4 py-14 grid md:grid-cols-3 gap-10 text-sm">
        <div>
          <p class="font-display text-xl font-semibold text-white mb-4">Gruissan Cozy</p>
          <p class="leading-relaxed">
            {site.adresse_ligne}<br />{site.code_postal} {site.ville}<br />{site.region}
          </p>
        </div>
        <div>
          <p class="font-semibold text-white mb-4">{tr['footer.contact']}</p>
          <p class="space-y-1">
            <!-- Téléphone et WhatsApp : masqués tant que les coordonnées sont vides -->
            {montrerAppel && appelLien && (
              <a href={appelLien} class="hover:text-white transition-colors block">{telephoneAffiche}</a>
            )}
            {montrerWhatsApp && whatsappLien && (
              <a href={whatsappLien} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors block">WhatsApp</a>
            )}
            <a href={`mailto:${site.email}`} class="hover:text-white transition-colors block">{site.email}</a>
          </p>
        </div>
        <div>
          <p class="font-semibold text-white mb-4">{tr['footer.liens']}</p>
          <p class="flex flex-wrap gap-x-5 gap-y-2">
            {site.airbnb_url && <a href={site.airbnb_url} class="hover:text-white transition-colors">{tr['contact.airbnb']}</a>}
            {site.abritel_url && <a href={site.abritel_url} class="hover:text-white transition-colors">{tr['contact.abritel']}</a>}
            {site.instagram_url && <a href={site.instagram_url} class="hover:text-white transition-colors">{tr['contact.instagram']}</a>}
          </p>
        </div>
      </div>
      <div class="border-t border-ocean-800 py-5 text-center text-xs text-ocean-200/50">
        © {year} Gruissan Cozy · {tr['footer.rights']}
      </div>
    </footer>
  </body>
</html>
