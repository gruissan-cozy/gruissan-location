---
/**
 * Layout commun du back office /admin.
 *
 * - barre de navigation interne (les 5 sections)
 * - garde d'authentification : si Supabase n'est pas configuré, ou si la
 *   session n'est pas ouverte, le contenu de la page est masqué et un
 *   panneau explicite est affiché à la place.
 * - la session est propagée aux scripts des pages via onAdminReady().
 */
import '../styles/global.css';
import { isSupabaseConfigured } from '../lib/supabase';
import { AT } from '../i18n/admin';

interface Props {
  title: string;
  /** Section courante, pour surligner l'onglet de navigation. */
  section: 'dashboard' | 'messages' | 'disponibilites' | 'packs' | 'guide';
  /**
   * `true` (défaut) : le contenu est masqué jusqu'à l'ouverture de session.
   * `false` : la page gère elle-même ses états (écran de connexion de /admin/).
   */
  requireAuth?: boolean;
}

const { title, section, requireAuth = true } = Astro.props as Props;
const base = import.meta.env.BASE_URL ?? '/';
const configured = isSupabaseConfigured;

const NAV = [
  { key: 'dashboard', href: `${base}admin/`, label: AT['nav.dashboard'], icon: '▤' },
  { key: 'messages', href: `${base}admin/messages/`, label: AT['nav.messages'], icon: '✉' },
  { key: 'disponibilites', href: `${base}admin/disponibilites/`, label: AT['nav.dispo'], icon: '▦' },
  { key: 'packs', href: `${base}admin/packs/`, label: AT['nav.packs'], icon: '✚' },
  { key: 'guide', href: `${base}admin/guide/`, label: AT['nav.guide'], icon: '☰' },
] as const;

const loginHref = `${base}admin/`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Back office Gruissan Cozy</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/gruissan-location/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-sand-50 font-sans text-ocean-900 antialiased">
    <!-- En-tête -->
    <header class="sticky top-0 z-40 border-b border-sand-200/60 bg-sand-50/95 backdrop-blur-sm shadow-nav">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center justify-between gap-3">
          <a href={base} class="flex items-center gap-2">
            <svg class="w-7 h-7" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <rect width="64" height="64" rx="14" fill="#15648a"/>
              <path d="M8 44 Q20 36 32 42 T56 40 V56 H8 Z" fill="#a9d9ec"/>
              <circle cx="44" cy="20" r="8" fill="#e8926b"/>
            </svg>
            <span class="font-display text-lg font-semibold text-ocean-800">Gruissan Cozy</span>
            <span class="hidden rounded-full bg-ocean-100 px-2 py-0.5 text-xs font-medium text-ocean-700 sm:inline">
              {AT['auth.brand']}
            </span>
          </a>
          <a
            href={base}
            class="text-xs text-ocean-700/70 underline-offset-2 hover:text-ocean-600 hover:underline sm:hidden"
            >{AT['common.backToSite']}</a
          >
        </div>

        <!-- Onglets de section -->
        <nav class="-mx-1 flex gap-1 overflow-x-auto px-1 pb-0.5" aria-label="Sections du back office">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                aria-current={item.key === section ? 'page' : undefined}
                class:list={[
                  'flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1.5 text-sm transition-colors',
                  item.key === section
                    ? 'bg-ocean-600 font-semibold text-white shadow-card'
                    : 'text-ocean-700/80 hover:bg-ocean-50 hover:text-ocean-600',
                ]}
              >
                <span aria-hidden="true" class="text-xs opacity-70">{item.icon}</span>
                {item.label}
              </a>
            ))
          }
        </nav>

        <!-- Compte connecté -->
        <div class="flex items-center gap-3">
          <span id="admin-user" class="hidden max-w-[16rem] truncate text-xs text-ocean-700/70 sm:block"></span>
          <a
            href={base}
            class="hidden text-xs text-ocean-700/70 underline-offset-2 hover:text-ocean-600 hover:underline sm:inline"
            >{AT['common.backToSite']}</a
          >
          <button
            id="admin-logout"
            type="button"
            class="hidden rounded-full border border-sand-300 bg-white px-3 py-1.5 text-xs font-medium text-ocean-800 transition-colors hover:bg-sand-50"
            >{AT['common.logout']}</button
          >
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <!-- Panneau : Supabase non configuré -->
      {
        !configured && (
          <div class="mx-auto max-w-2xl rounded-2xl border border-amber-200 bg-amber-50 p-6 shadow-card">
            <h1 class="font-display text-xl font-semibold text-amber-900">{AT['sb.title']}</h1>
            <p class="mt-2 text-sm leading-relaxed text-amber-900/80">{AT['sb.body']}</p>
            <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-amber-900/80">
              <li>{AT['sb.step1']}</li>
              <li>{AT['sb.step2']}</li>
              <li>{AT['sb.step3']}</li>
            </ol>
            <p class="mt-5 text-xs text-amber-900/60">
              Variables attendues : <code class="rounded bg-amber-100 px-1 py-0.5">PUBLIC_SUPABASE_URL</code> et{' '}
              <code class="rounded bg-amber-100 px-1 py-0.5">PUBLIC_SUPABASE_ANON_KEY</code>
            </p>
            <a
              href={base}
              class="mt-5 inline-flex rounded-full bg-ocean-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-ocean-700"
            >
              {AT['common.backToSite']}
            </a>
          </div>
        )
      }

      <!-- Contenu de la page (masqué jusqu'à authentification si requireAuth) -->
      <div id="admin-content" data-require-auth={requireAuth ? 'true' : 'false'}>
        <slot />
      </div>

      <!-- Panneau : session absente (masqué par défaut, révélé par le script) -->
      <div id="admin-auth-required" class="hidden">
        <div class="mx-auto max-w-xl rounded-2xl border border-sand-200/70 bg-white p-8 text-center shadow-card">
          <p class="text-3xl" aria-hidden="true">🔒</p>
          <h1 class="mt-3 font-display text-xl font-semibold text-ocean-900">{AT['auth.requiredTitle']}</h1>
          <p class="mt-2 text-sm leading-relaxed text-ocean-700/80">{AT['auth.requiredBody']}</p>
          <a
            href={loginHref}
            class="mt-5 inline-flex rounded-full bg-sunset-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-sunset-600"
            >{AT['auth.requiredCta']}</a
          >
        </div>
      </div>

      <!-- Panneau : email non autorisé (masqué par défaut, révélé par le script) -->
      <div id="admin-auth-forbidden" class="hidden">
        <div class="mx-auto max-w-xl rounded-2xl border border-rose-200 bg-rose-50 p-8 text-center shadow-card">
          <p class="text-3xl" aria-hidden="true">⛔</p>
          <h1 class="mt-3 font-display text-xl font-semibold text-rose-900">Accès refusé</h1>
          <p class="mt-2 text-sm leading-relaxed text-rose-900/80">
            Cet email n'est pas autorisé à accéder au back office. Seul le propriétaire
            du bien peut y accéder.
          </p>
          <button
            id="admin-logout-forbidden"
            class="mt-5 inline-flex rounded-full bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-rose-700"
            >Se déconnecter</button
          >
        </div>
      </div>
    </main>

    <script>
      import { getSupabase } from '../lib/supabase';
      import { resolveAdminReady } from '../lib/admin-runtime';

      const content = document.getElementById('admin-content');
      const authRequired = document.getElementById('admin-auth-required');
      const authForbidden = document.getElementById('admin-auth-forbidden');
      const logoutBtn = document.getElementById('admin-logout');
      const userSlot = document.getElementById('admin-user');
      // `requireAuth` est une variable de frontmatter : elle n'est pas
      // accessible dans un <script> bundlé, on la lit donc depuis le DOM.
      const requireAuth = content?.dataset.requireAuth !== 'false';
      // Seul cet email a le droit d'accéder au back office (le verrou
      // principal est côté base de données : politiques RLS).
      const ALLOWED_EMAIL = 'gruissancozy@gmail.com';

      const supabase = getSupabase();
      if (!supabase) {
        // Panneau « non configuré » déjà affiché côté serveur : rien à faire.
      } else {
        const applySession = (session: { user?: { email?: string | null } | null } | null) => {
          const authed = Boolean(session?.user);
          const allowed = session?.user?.email === ALLOWED_EMAIL;
          if (requireAuth) {
            if (content) content.classList.toggle('hidden', !authed || !allowed);
            if (authRequired) authRequired.classList.toggle('hidden', authed);
            if (authForbidden) authForbidden.classList.toggle('hidden', !authed || allowed);
          }
          if (logoutBtn) logoutBtn.classList.toggle('hidden', !authed);
          if (userSlot) {
            userSlot.textContent = authed ? `${session?.user?.email ?? ''}` : '';
            userSlot.classList.toggle('hidden', !authed);
          }
          if (authed && allowed) resolveAdminReady({ email: session?.user?.email ?? null });
        };

        // Écoute les changements (magic link, expiration, déconnexion).
        supabase.auth.onAuthStateChange((_event, session) => applySession(session));

        // État initial.
        supabase.auth.getSession().then(({ data }) => applySession(data.session));

        logoutBtn?.addEventListener('click', async () => {
          await supabase.auth.signOut();
          // On revient à l'écran de connexion du back office.
          const base = import.meta.env.BASE_URL ?? '/';
          window.location.href = `${base}admin/`;
        });

        // Bouton de déconnexion du panneau « accès refusé ».
        document.getElementById('admin-logout-forbidden')?.addEventListener('click', async () => {
          await supabase.auth.signOut();
          const base = import.meta.env.BASE_URL ?? '/';
          window.location.href = `${base}admin/`;
        });
      }
    </script>
  </body>
</html>
