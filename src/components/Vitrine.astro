  <script define:vars={{ photosVisionneuse, lang, titresPieces, visionneuseTr: visionneuseTraductions(lang) }}>
    // Visionneuse plein écran : ouverture au clic, navigation clavier
    // (Échap pour fermer, flèches pour naviguer), focus conservé dans la boîte.
    (() => {
      const boite = document.getElementById('visionneuse');
      if (!boite || !photosVisionneuse.length) return;
      const image = boite.querySelector('[data-visionneuse-image]');
      const legende = boite.querySelector('[data-visionneuse-legende]');
      const categorie = boite.querySelector('[data-visionneuse-categorie]');
      const compteur = boite.querySelector('[data-visionneuse-compteur]');
      const boutonFermer = boite.querySelector('[data-visionneuse-fermer]');
      const boutonPrecedent = boite.querySelector('[data-visionneuse-precedent]');
      const boutonSuivant = boite.querySelector('[data-visionneuse-suivant]');

      let index = 0;
      let dernierFocus = null;

      function lireLegende(photo) {
        const alt = photo?.alt ?? photo?.legende ?? {};
        return alt[lang] ?? alt.fr ?? '';
      }

      function rendre() {
        const photo = photosVisionneuse[index];
        if (!photo) return;
        image.src = photo.src;
        image.alt = lireLegende(photo);
        legende.textContent = lireLegende(photo);
        categorie.textContent = titresPieces[photo.categorie]?.[lang] ?? '';
        compteur.textContent = visionneuseTr['visionneuse.compteur']
          .replace('{0}', String(index + 1))
          .replace('{1}', String(photosVisionneuse.length));
      }

      function ouvrir(depuis, declencheur) {
        index = Math.max(0, Number(depuis) || 0);
        rendre();
        // Le focus revient sur le bouton qui a ouvert la visionneuse : si ce
        // dernier n'est plus dans le document, on retombe sur la photo éponyme.
        dernierFocus = declencheur instanceof HTMLElement
          ? declencheur
          : document.querySelector(`[data-visionneuse-ouvrir="${index}"]`);
        boite.classList.remove('hidden');
        boite.classList.add('flex');
        document.body.style.overflow = 'hidden';
        boutonFermer.focus();
      }

      function fermer() {
        boite.classList.add('hidden');
        boite.classList.remove('flex');
        document.body.style.overflow = '';
        if (dernierFocus instanceof HTMLElement) dernierFocus.focus();
      }

      function suivant() {
        index = (index + 1) % photosVisionneuse.length;
        rendre();
      }

      function precedent() {
        index = (index - 1 + photosVisionneuse.length) % photosVisionneuse.length;
        rendre();
      }

      for (const bouton of document.querySelectorAll('[data-visionneuse-ouvrir]')) {
        bouton.addEventListener('click', () => ouvrir(bouton.getAttribute('data-visionneuse-ouvrir'), bouton));
      }
      boutonFermer.addEventListener('click', fermer);
      boutonPrecedent.addEventListener('click', precedent);
      boutonSuivant.addEventListener('click', suivant);

      document.addEventListener('keydown', (e) => {
        if (boite.classList.contains('hidden')) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          fermer();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          suivant();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          precedent();
        }
      });
    })();
  </script>
</Layout>

{
  supabaseConfigured && (
    <script define:vars={{ supabaseUrl, supabaseKey, sentMsg: tr['contact.sent'], errorMsg: tr['contact.error'] }}>
      // Formulaire de contact : insert dans Supabase (table messages).
      // Sans configuration Supabase, le POST FormSubmit natif reste actif.
      import('@supabase/supabase-js').then(({ createClient }) => {
        const sb = createClient(supabaseUrl, supabaseKey);
        const form = document.getElementById('contact-form');
        if (!form) return;
        const msg = document.getElementById('contact-msg');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          msg.className = 'hidden text-sm rounded-xl px-4 py-3';
          const { error } = await sb.from('messages').insert({
            nom: document.getElementById('nom').value,
            email: document.getElementById('email').value,
            telephone: null,
            dates: document.getElementById('dates').value || null,
            message: document.getElementById('message').value,
          });
          if (error) {
            msg.textContent = errorMsg;
            msg.className = 'text-sm text-rose-700 bg-rose-50 rounded-xl px-4 py-3';
            return;
          }
          msg.textContent = sentMsg;
          msg.className = 'text-sm text-emerald-800 bg-emerald-50 rounded-xl px-4 py-3';
          form.reset();
        });
      });
    </script>
  )
