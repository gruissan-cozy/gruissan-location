          data-cal-precedent
          class="inline-flex items-center gap-2 rounded-full border border-sand-200 bg-white px-5 py-2.5 text-sm font-semibold text-ocean-800 transition-colors hover:border-ocean-300 hover:bg-ocean-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-ocean-400"
