          ? calTr['calendrier.nuitsLibres'].replace('{0}', String(moisCourant.nuitsLibres))
          : calTr['calendrier.aucunLibre']}
      </p>
      <p data-cal-note class="mt-2 max-w-3xl text-sm text-ocean-700/70">{noteCalendrier}</p>

      <div class="mt-8 overflow-x-auto rounded-2xl border border-sand-200 bg-white shadow-card">
        <table class="w-full min-w-[560px] border-collapse">
          <caption class="sr-only">{calTr['calendrier.aria.table']}</caption>
          <thead class="bg-sand-50">
            <tr>
              {entetesSemaine.map((e) => (
                <th
                  scope="col"
                  abbr={e.long}
                  class="px-2 py-3 text-center text-xs font-semibold uppercase tracking-wider text-ocean-700/70"
                >
                  {e.court}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-sand-200/80" data-cal-corps>
            {semaines.map((semaine) => (
              <tr>
                {semaine.map((iso) => {
                  if (!iso) {
                    return <td class="h-14 border-l border-sand-200/60 bg-sand-50/50" aria-hidden="true"></td>;
                  }
                  const j = joursParIso.get(iso)!;
                  const classe = [
                    'flex h-14 items-center justify-center border-l border-sand-200/60 text-sm tabular-nums transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sunset-400',
                    j.weekend ? 'font-semibold' : '',
                    classeEtat[j.etat],
                    j.passe ? 'opacity-40' : '',
                    iso === aujourdHui ? 'ring-2 ring-inset ring-sunset-500' : '',
                  ].join(' ');
                  return (
                    <td class="p-0">
                      {j.plageLibre ? (
                        <a href={lienReserver(j.plageLibre)} class={classe}>
                          <span aria-hidden="true">{j.jour}</span>
                          <span class="sr-only">{texteAccessible(j)}</span>
                        </a>
                      ) : (
                        <span class:list={[classe, 'cursor-default']}>
                          <span aria-hidden="true">{j.jour}</span>
                          <span class="sr-only">{texteAccessible(j)}</span>
                        </span>
                      )}
                    </td>
                  );
                })}
              </tr>
