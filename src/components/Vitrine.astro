        {!montrerContactDirect && (
          <p class="text-sm text-ocean-700/70">{tr['contact.raccrocher']}</p>
        )}
        {(site.airbnb_url || site.abritel_url || site.booking_url || site.instagram_url) && (
          <div>
            <p class="text-ocean-700/70 mb-4">{tr['contact.plateformes']}:</p>
            <div class="flex flex-wrap gap-3">
              {site.airbnb_url && <a href={site.airbnb_url} class="bg-white border border-sand-200 hover:border-ocean-300 px-4 py-2 rounded-full transition-colors text-sm font-medium text-ocean-800">{tr['contact.airbnb']}</a>}
              {site.abritel_url && <a href={site.abritel_url} class="bg-white border border-sand-200 hover:border-ocean-300 px-4 py-2 rounded-full transition-colors text-sm font-medium text-ocean-800">{tr['contact.abritel']}</a>}
              {site.booking_url && <a href={site.booking_url} class="bg-white border border-sand-200 hover:border-ocean-300 px-4 py-2 rounded-full transition-colors text-sm font-medium text-ocean-800">{tr['contact.booking']}</a>}
              {site.instagram_url && <a href={site.instagram_url} class="bg-white border border-sand-200 hover:border-ocean-300 px-4 py-2 rounded-full transition-colors text-sm font-medium text-ocean-800">{tr['contact.instagram']}</a>}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <script define:vars={{ photosVisionneuse, lang, titresPieces, visionneuseTr: visionneuseTraductions(lang) }}>
    // Visionneuse plein écran : ouverture au clic, navigation clavier
    // (Échap pour fermer, flèches pour naviguer), focus conservé dans la boîte.
    (() => {
      const boite = document.getElementById('visionneuse');
      if (!boite || !photosVisionneuse.length) return;
      const image = boite.querySelector('[data-visionneuse-image]');
      const legende = boite.querySelector('[data-visionneuse-legende]');
      const categorie = boite.querySelector('[data-visionneuse-categorie]');
      const compteur = boite.querySelector('[data-visionneuse-compteur]');
      const boutonFermer = boite.querySelector('[data-visionneuse-fermer]');
      const boutonPrecedent = boite.querySelector('[data-visionneuse-precedent]');
      const boutonSuivant = boite.querySelector('[data-visionneuse-suivant]');

      let index = 0;
      let dernierFocus = null;

      function lireLegende(photo) {
        const alt = photo?.alt ?? photo?.legende ?? {};
        return alt[lang] ?? alt.fr ?? '';
      }

      function rendre() {
        const photo = photosVisionneuse[index];
        if (!photo) return;
        image.src = photo.src;
        image.alt = lireLegende(photo);
        legende.textContent = lireLegende(photo);
        categorie.textContent = titresPieces[photo.categorie]?.[lang] ?? '';
        compteur.textContent = visionneuseTr['visionneuse.compteur']
          .replace('{0}', String(index + 1))
          .replace('{1}', String(photosVisionneuse.length));
      }

      function ouvrir(depuis, declencheur) {
        index = Math.max(0, Number(depuis) || 0);
        rendre();
        // Le focus revient sur le bouton qui a ouvert la visionneuse : si ce
        // dernier n'est plus dans le document, on retombe sur la photo éponyme.
        dernierFocus = declencheur instanceof HTMLElement
          ? declencheur
          : document.querySelector(`[data-visionneuse-ouvrir="${index}"]`);
        boite.classList.remove('hidden');
        boite.classList.add('flex');
        document.body.style.overflow = 'hidden';
        boutonFermer.focus();
      }

      function fermer() {
        boite.classList.add('hidden');
        boite.classList.remove('flex');
        document.body.style.overflow = '';
        if (dernierFocus instanceof HTMLElement) dernierFocus.focus();
      }

      function suivant() {
        index = (index + 1) % photosVisionneuse.length;
        rendre();
      }

      function precedent() {
        index = (index - 1 + photosVisionneuse.length) % photosVisionneuse.length;
        rendre();
      }

      for (const bouton of document.querySelectorAll('[data-visionneuse-ouvrir]')) {
        bouton.addEventListener('click', () => ouvrir(bouton.getAttribute('data-visionneuse-ouvrir'), bouton));
      }
      boutonFermer.addEventListener('click', fermer);
      boutonPrecedent.addEventListener('click', precedent);
      boutonSuivant.addEventListener('click', suivant);

      document.addEventListener('keydown', (e) => {
        if (boite.classList.contains('hidden')) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          fermer();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          suivant();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          precedent();
        }
      });
    })();
  </script>

  <script define:vars={{ cfgCalendrier }}>
import { ajouterMois, construireMois, grilleSemaines, parseMois } from '../lib/calendrier';

    // Le corps est encapsulé dans une IIFE : les scripts Astro sont compilés
    // au niveau racine du module, où un `return` anticipé est interdit.
    (() => {

      // Calendrier de disponibilités : bascule de mois sans rechargement de page.
      // Le mois courant est rendu côté serveur (le calendrier reste lisible sans
      // JavaScript) ; le script reconstruit les autres mois avec la même logique
      // pure que le serveur, issue de src/lib/calendrier.ts.

      const { lang, aujourdHui, slugDefaut, plages, nomsMois, reserverBase, t } = cfgCalendrier;

      const corps = document.querySelector('[data-cal-corps]');
      const titre = document.querySelector('[data-cal-titre]');
      const nuits = document.querySelector('[data-cal-nuits]');
      const select = document.querySelector('[data-cal-select]');
      const boutonPrecedent = document.querySelector('[data-cal-precedent]');
      const boutonSuivant = document.querySelector('[data-cal-suivant]');
      if (!corps) return;

      const fmtDate = new Intl.DateTimeFormat(lang, {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      });
      const dateLongue = (iso) => fmtDate.format(new Date(`${iso}T00:00:00Z`));

      const libelleMois = (slug) => {
        const p = parseMois(slug);
        return p ? `${nomsMois[p.mois - 1]} ${p.annee}` : slug;
      };

      const CLASSE_BASE =
        'flex h-14 items-center justify-center border-l border-sand-200/60 text-sm tabular-nums transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sunset-400';
      const CLASSE_ETAT = {
        libre: 'bg-emerald-50/60 text-emerald-700 hover:bg-emerald-100',
        occupe: 'bg-rose-50/60 text-rose-700',
        partiel: 'bg-amber-50/60 text-amber-800',
      };

      const lienReserver = (plage) => `${reserverBase}?arrivee=${plage.debut}&depart=${plage.fin}`;

      /** Nom du jour + état, ou action « choisir cette plage » (lu par les lecteurs d'écran). */
      function texteAccessible(j) {
        const date = dateLongue(j.iso);
        if (j.plageLibre) {
          const action = t.choisir
            .replace('{debut}', dateLongue(j.plageLibre.debut))
            .replace('{fin}', dateLongue(j.plageLibre.fin));
          return `${date} · ${action}`;
        }
        const libelle = { libre: t.etatLibre, occupe: t.etatOccupe, partiel: t.etatPartiel }[j.etat];
        return `${date} · ${j.passe ? `${libelle} · ${t.etatPasse}` : libelle}`;
      }

      function cellule(j) {
        const td = document.createElement('td');
        td.className = 'p-0';
        const classe = [
          CLASSE_BASE,
          j.weekend ? 'font-semibold' : '',
          CLASSE_ETAT[j.etat] ?? '',
          j.passe ? 'opacity-40' : '',
          j.iso === aujourdHui ? 'ring-2 ring-inset ring-sunset-500' : '',
        ].join(' ');
        const chiffre = document.createElement('span');
        chiffre.setAttribute('aria-hidden', 'true');
        chiffre.textContent = String(j.jour);
        const accessible = document.createElement('span');
        accessible.className = 'sr-only';
        accessible.textContent = texteAccessible(j);
        if (j.plageLibre) {
          const a = document.createElement('a');
          a.href = lienReserver(j.plageLibre);
          a.className = classe;
          a.append(chiffre, accessible);
          td.append(a);
        } else {
          const s = document.createElement('span');
          s.className = `${classe} cursor-default`;
          s.append(chiffre, accessible);
          td.append(s);
        }
        return td;
      }

      /** Ajoute l'option du mois courant s'il sort de la liste pré-calculée. */
      function assurerOption(liste, slug) {
        if (!liste || [...liste.options].some((o) => o.value === slug)) return;
        const opt = document.createElement('option');
        opt.value = slug;
        opt.textContent = libelleMois(slug);
        const suivante = [...liste.options].find((o) => o.value > slug);
        if (suivante) liste.insertBefore(opt, suivante);
        else liste.append(opt);
      }

      function rendre(slug) {
        const p = parseMois(slug);
        if (!p) return;
        const mois = construireMois(p.annee, p.mois, plages, { aujourdHui });
        corps.replaceChildren();
        for (const semaine of grilleSemaines(p.annee, p.mois, 1)) {
          const tr = document.createElement('tr');
          for (const iso of semaine) {
            if (!iso) {
              const td = document.createElement('td');
              td.className = 'h-14 border-l border-sand-200/60 bg-sand-50/50';
              td.setAttribute('aria-hidden', 'true');
              tr.append(td);
              continue;
            }
            const jour = mois.jours.find((x) => x.iso === iso);
            if (jour) tr.append(cellule(jour));
          }
          corps.append(tr);
        }
        if (titre) titre.textContent = libelleMois(slug);
        if (nuits) {
          nuits.textContent =
            mois.nuitsLibres > 0
              ? t.nuitsLibres.replace('{0}', String(mois.nuitsLibres))
              : t.aucunLibre;
        }
        assurerOption(select, slug);
        if (select) select.value = slug;
        // Le mois reste partageable dans l'URL (signet, lien copié).
        const url = new URL(window.location.href);
        url.searchParams.set('mois', slug);
        url.hash = 'dispo';
        window.history.replaceState(null, '', url.toString());
      }

      let slugCourant = (() => {
        const demande = new URLSearchParams(window.location.search).get('mois');
        return demande && parseMois(demande) ? demande : slugDefaut;
      })();

      rendre(slugCourant);

      select?.addEventListener('change', () => {
        if (parseMois(select.value)) {
          slugCourant = select.value;
          rendre(slugCourant);
        }
      });
      boutonPrecedent?.addEventListener('click', () => {
        slugCourant = ajouterMois(slugCourant, -1);
        rendre(slugCourant);
      });
      boutonSuivant?.addEventListener('click', () => {
        slugCourant = ajouterMois(slugCourant, 1);
        rendre(slugCourant);
      });
  
    })();
  </script>
</Layout>

{
  supabaseConfigured && (
    <script define:vars={{ supabaseUrl, supabaseKey, sentMsg: tr['contact.sent'], errorMsg: tr['contact.error'] }}>
      // Formulaire de contact : insert dans Supabase (table messages).
      // Sans configuration Supabase, le POST FormSubmit natif reste actif.
      import('@supabase/supabase-js').then(({ createClient }) => {
        const sb = createClient(supabaseUrl, supabaseKey);
        const form = document.getElementById('contact-form');
        if (!form) return;
        const msg = document.getElementById('contact-msg');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          msg.className = 'hidden text-sm rounded-xl px-4 py-3';
          const { error } = await sb.from('messages').insert({
            nom: document.getElementById('nom').value,
            email: document.getElementById('email').value,
            telephone: null,
            dates: document.getElementById('dates').value || null,
            message: document.getElementById('message').value,
          });
          if (error) {
            msg.textContent = errorMsg;
            msg.className = 'text-sm text-rose-700 bg-rose-50 rounded-xl px-4 py-3';
            return;
          }
          msg.textContent = sentMsg;
          msg.className = 'text-sm text-emerald-800 bg-emerald-50 rounded-xl px-4 py-3';
          form.reset();
        });
      });
    </script>
  )
}
