---
import Layout from '../layouts/Layout.astro';
import site from '../../content/site.json';
import tarifsData from '../../content/tarifs.json';
import dispoData from '../../content/disponibilites.json';
import galerieData from '../../content/galerie.json';
import proxiData from '../../content/proximite.json';
import avisData from '../../content/avis.json';
import faqData from '../../content/faq.json';
import annulationData from '../../content/annulation.json';
import { t } from '../i18n';
import type { Lang } from '../i18n';
import { isSupabaseConfigured } from '../lib/supabase';
import {
  chargerGalerie,
  extraitNumeroAppel,
  legendePhoto,
  lienWhatsApp,
  libelleNumero,
  numeroAppel,
  peutAppeler,
  peutUtiliserWhatsApp,
  visionneuseTraductions,
  type Photo,
} from '../lib/contact';
import {
  MOIS_PAR_LANGUE,
  afficherSectionAvis,
  avisVisibles,
  cleSourceAvis,
  dateAffichee,
  faqJsonLd,
  avisJsonLd,
  jsonLd,
  noteMoyenne,
  type Avis,
  type FaqEntree,
} from '../lib/confiance';

interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const tr = t[lang];
const supabaseConfigured = isSupabaseConfigured;
const supabaseUrl = supabaseConfigured ? String(import.meta.env.PUBLIC_SUPABASE_URL) : '';
const supabaseKey = supabaseConfigured ? String(import.meta.env.PUBLIC_SUPABASE_ANON_KEY) : '';

// --- Contact direct : les boutons n'existent que si une vraie coordonnée est renseignée ---
// Aucun numéro n'est fabriqué : téléphone et WhatsApp vides => rien n'est affiché.
const coordonnees = site;
const appelLien = numeroAppel(coordonnees.telephone);
const appelLibelle = libelleNumero(coordonnees);
const whatsappLien = lienWhatsApp(coordonnees.telephone, coordonnees.whatsapp);
// Le numéro réel de WhatsApp (distinct du téléphone le cas échéant).
const whatsappNumero = extraitNumeroAppel(coordonnees.whatsapp) || extraitNumeroAppel(coordonnees.telephone);
const whatsappLibelle = whatsappNumero ? `+${whatsappNumero}` : '';
const montrerAppel = peutAppeler(coordonnees);
const montrerWhatsApp = peutUtiliserWhatsApp(coordonnees);
const montrerContactDirect = montrerAppel || montrerWhatsApp;

// --- Galerie : photos regroupées par pièce (content/galerie.json reste le seul maître) ---
const galerieGroupes = chargerGalerie(galerieData);
const photosPlates: Photo[] = galerieData.photos ?? [];
// Ordre d'affichage de la visionneuse : les photos dans l'ordre du fichier,
// en ignorant les entrées sans image (jamais de case vide dans le plein écran).
const photosVisionneuse = photosPlates.filter((p) => Boolean(p?.src));
const nombrePhotos = photosVisionneuse.length;
// Titres de pièces traduits : la visionneuse affiche la pièce courante, donc
// ils sont sérialisés ici (le contenu JSON reste la seule source d'édition).
const titresPieces: Record<string, Record<string, string>> = {};
for (const groupe of galerieGroupes) titresPieces[groupe.categorie.id] = groupe.categorie.titre as Record<string, string>;

function fmtMonth(iso: string): string {
  const [y, m] = iso.split('-');
  return `${MOIS_PAR_LANGUE[lang][Number(m) - 1]} ${y}`;
}

function fmtDist(m: number): string {
  return m >= 1000 ? `${(m / 1000).toFixed(m % 1000 === 0 ? 0 : 1)} km` : `${m} m`;
}

// --- Avis clients : la section entière est masquée si aucun avis n'est publiable ---
const avisListe: Avis[] = avisData.avis;
const avisAffiches = avisVisibles(avisListe, lang);
const montrerAvis = afficherSectionAvis(avisListe, lang);
const moyenneAvis = noteMoyenne(avisListe, lang);
const libelleSource = (source: string): string => tr[cleSourceAvis(source) ?? ''] ?? source;

// --- FAQ : balisage structuré et repérage des points encore à valider ---
const faqEntrees = (faqData.questions ?? []) as FaqEntree[];
const faqAPValider = faqEntrees.some((e) => e.a_valider === true);
const faqSchema = faqJsonLd(faqEntrees, lang);

// --- Conditions d'annulation : barème type, explicitement à valider ---
const annulationAPValider = annulationData.a_valider === true;

const statutClass: Record<string, string> = {
  libre: 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200',
  reserve: 'bg-rose-50 text-rose-700 ring-1 ring-rose-200',
  partiel: 'bg-amber-50 text-amber-700 ring-1 ring-amber-200',
};
---

<Layout lang={lang} title={tr['hero.title']}>
  <!-- Hero — photo plein cadre avec voile sombre -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden">
    <img
      src="/gruissan-location/images/hero.svg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-900/85 via-ocean-900/55 to-ocean-900/20"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-24 w-full">
      <p class="text-sunset-400 text-xs font-semibold tracking-[0.25em] uppercase mb-5">
        {tr['hero.badge']}
      </p>
      <h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-semibold text-white max-w-3xl leading-[1.05]">
        {tr['hero.title']}
      </h1>
      <p class="mt-6 text-lg md:text-xl text-sand-100/90 max-w-xl leading-relaxed">
        {tr['hero.subtitle']}
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#tarifs"
          class="bg-sunset-500 hover:bg-sunset-600 text-white font-semibold px-7 py-3.5 rounded-full transition-colors shadow-lg shadow-sunset-600/25"
        >{tr['hero.cta1']}</a>
        <a
          href="#contact"
          class="border border-white/40 hover:bg-white/10 text-white font-semibold px-7 py-3.5 rounded-full transition-colors"
        >{tr['hero.cta2']}</a>
        <a
          href={`/gruissan-location/${lang === 'fr' ? '' : lang + '/'}reserver/`}
          class="bg-white/10 border border-white/40 hover:bg-white/20 text-white font-semibold px-7 py-3.5 rounded-full transition-colors"
        >{tr['nav.reserver']}</a>
        <!-- Contact direct : masqué tant que content/site.json n'a pas de vraie coordonnée -->
        {montrerAppel && appelLien && (
          <a
            href={appelLien}
            class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold px-7 py-3.5 rounded-full transition-colors shadow-lg shadow-emerald-600/25"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            {tr['contact.appel']}
          </a>
        )}
        {montrerWhatsApp && whatsappLien && (
          <a
            href={whatsappLien}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#1ebe5b] text-white font-semibold px-7 py-3.5 rounded-full transition-colors shadow-lg shadow-emerald-600/25"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            WhatsApp
          </a>
        )}
      </div>
    </div>
    <!-- Indicateur de scroll -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/50 animate-bounce" aria-hidden="true">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </section>

  <!-- Appartement -->
  <section id="appart" class="max-w-6xl mx-auto px-4 py-24 scroll-mt-16">
    <p class="text-sunset-600 text-xs font-semibold tracking-[0.25em] uppercase mb-4">
      {tr['appart.subtitle']}
    </p>
    <h2 class="font-display text-3xl md:text-5xl font-semibold text-ocean-900 max-w-2xl leading-tight">
      {tr['appart.title']}
    </h2>
    <p class="mt-8 max-w-2xl text-ocean-700/80 text-lg leading-relaxed">{tr['appart.desc']}</p>
    <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-px bg-sand-200 rounded-2xl overflow-hidden shadow-card">
      <div class="bg-sand-50 p-8 text-center">
        <p class="font-display text-5xl font-semibold text-ocean-600">{site.capacite}</p>
        <p class="text-xs text-ocean-700/60 mt-2 uppercase tracking-wider">{tr['appart.capacite']}</p>
      </div>
      <div class="bg-sand-50 p-8 text-center">
        <p class="font-display text-5xl font-semibold text-ocean-600">{site.chambres}</p>
        <p class="text-xs text-ocean-700/60 mt-2 uppercase tracking-wider">{tr['appart.chambres']}</p>
      </div>
      <div class="bg-sand-50 p-8 text-center">
        <p class="font-display text-5xl font-semibold text-ocean-600">{site.surface_m2}<span class="text-2xl font-normal"> m²</span></p>
        <p class="text-xs text-ocean-700/60 mt-2 uppercase tracking-wider">{tr['appart.surface']}</p>
      </div>
      <div class="bg-sand-50 p-8 text-center">
        <p class="font-display text-5xl font-semibold text-ocean-600">{site.terrasse_m2}<span class="text-2xl font-normal"> m²</span></p>
        <p class="text-xs text-ocean-700/60 mt-2 uppercase tracking-wider">{tr['appart.terrasse']}</p>
      </div>
    </div>
  </section>

  <!-- À proximité -->
  <section id="proxi" class="bg-sand-100 py-24 scroll-mt-16">
    <div class="max-w-6xl mx-auto px-4">
      <p class="text-sunset-600 text-xs font-semibold tracking-[0.25em] uppercase mb-4">
        {tr['proxi.subtitle']}
      </p>
      <h2 class="font-display text-3xl md:text-5xl font-semibold text-ocean-900">{tr['proxi.title']}</h2>
      <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {proxiData.points.map((p) => (
          <div class="bg-white rounded-xl p-6 shadow-card flex flex-col">
            <p class="font-display text-2xl font-semibold text-ocean-800">{p.nom[lang]}</p>
            <p class="mt-1 text-sm text-ocean-700/70 mb-4">{p.detail[lang]}</p>
            <div class="mt-auto space-y-1.5 text-sm">
              <p class="flex items-center gap-2">
                <span aria-hidden="true">🚶</span>
                <span class="text-ocean-600 font-semibold tabular-nums">{p.routes.walking.duration_min} min</span>
                <span class="text-ocean-700/50">{fmtDist(p.routes.walking.distance_m)}</span>
              </p>
              <p class="flex items-center gap-2">
                <span aria-hidden="true">🚲</span>
                <span class="text-ocean-600 font-semibold tabular-nums">{p.routes.cycling.duration_min} min</span>
                <span class="text-ocean-700/50">{fmtDist(p.routes.cycling.distance_m)}</span>
              </p>
              <p class="flex items-center gap-2">
                <span aria-hidden="true">🚗</span>
                <span class="text-ocean-600 font-semibold tabular-nums">{p.routes.driving.duration_min} min</span>
                <span class="text-ocean-700/50">{fmtDist(p.routes.driving.distance_m)}</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Galerie -->
  <section id="galerie" class="bg-ocean-900 py-24 scroll-mt-16">
    <div class="max-w-6xl mx-auto px-4">
      <p class="text-sunset-400 text-xs font-semibold tracking-[0.25em] uppercase mb-4">
        {tr['galerie.subtitle']}
      </p>
      <h2 class="font-display text-3xl md:text-5xl font-semibold text-white">{tr['galerie.title']}</h2>
      <p class="mt-4 text-ocean-100/70 text-sm">
        {tr['galerie.piecesTitre']} · {nombrePhotos} {tr['galerie.photos'].replace('{0}', '')}
      </p>

      <!-- Pièces : une ancre par pièce, générée depuis content/galerie.json -->
      <nav class="mt-10 flex flex-wrap gap-2" aria-label={tr['galerie.pieces']}>
        {galerieGroupes.map((groupe) => (
          <a
            href={`#galerie-${groupe.categorie.id}`}
            class="text-sm font-medium px-4 py-2 rounded-full border border-ocean-700 text-ocean-100/80 hover:bg-ocean-800 hover:text-white transition-colors"
          >
            {groupe.categorie.titre[lang]}
            <span class="ml-1.5 text-ocean-300/70 tabular-nums">{groupe.photos.length}</span>
          </a>
        ))}
      </nav>

      <div class="mt-10 space-y-16">
        {galerieGroupes.map((groupe) => (
          <div id={`galerie-${groupe.categorie.id}`} class="scroll-mt-24">
            <h3 class="font-display text-2xl font-semibold text-white">
              {groupe.categorie.titre[lang]}
              <span class="ml-3 text-sm font-normal text-ocean-300/70 tabular-nums">
                {groupe.photos.length} {tr['galerie.photos'].replace('{0}', '')}
              </span>
            </h3>
            <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              {groupe.photos.map((photo) => {
                const index = photosVisionneuse.findIndex((p) => p.src === photo.src);
                const legende = legendePhoto(photo, lang);
                return (
                  <figure class="group relative rounded-2xl overflow-hidden aspect-[4/3] bg-ocean-800">
                    <img
                      src={photo.src}
                      alt={legende}
                      loading="lazy"
                      data-photo-index={index >= 0 ? index : undefined}
                      class="galerie-photo w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ocean-900/90 to-transparent p-5 pt-12">
                      <p class="text-sm text-sand-100">{legende}</p>
                    </figcaption>
                    <button
                      type="button"
                      data-visionneuse-ouvrir={index >= 0 ? index : undefined}
                      class="absolute inset-0 w-full h-full cursor-zoom-in focus:outline-none focus-visible:ring-4 focus-visible:ring-sunset-400 rounded-2xl"
                      aria-label={`${tr['visionneuse.ouvrir']} — ${legende}`}
                    >
                      <span class="sr-only">{tr['visionneuse.ouvrir']}</span>
                    </button>
                  </figure>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Visionneuse plein écran : navigation clavier (Échap, flèches), focus, aria -->
  <div
    id="visionneuse"
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-ocean-900/95 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label={tr['visionneuse.titre']}
  >
    <button
      type="button"
      data-visionneuse-fermer
      class="absolute top-4 right-4 z-10 inline-flex items-center justify-center w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white focus:outline-none focus-visible:ring-4 focus-visible:ring-sunset-400"
      aria-label={tr['visionneuse.fermer']}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button
      type="button"
      data-visionneuse-precedent
      class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-10 inline-flex items-center justify-center w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white focus:outline-none focus-visible:ring-4 focus-visible:ring-sunset-400"
      aria-label={tr['visionneuse.precedent']}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>
    <figure class="relative max-w-5xl w-full flex flex-col items-center gap-4">
      <img
        data-visionneuse-image
        src={photosVisionneuse[0]?.src ?? ''}
        alt={photosVisionneuse[0] ? legendePhoto(photosVisionneuse[0], lang) : ''}
        class="max-h-[78vh] w-auto max-w-full rounded-2xl object-contain shadow-card-hover"
      />
      <figcaption class="text-center">
        <p class="text-ocean-100/70 text-xs uppercase tracking-wider" data-visionneuse-categorie></p>
        <p class="mt-1 text-white" data-visionneuse-legende></p>
        <p class="mt-2 text-ocean-200/70 text-sm tabular-nums" role="status" aria-live="polite" data-visionneuse-compteur></p>
      </figcaption>
    </figure>
    <button
      type="button"
      data-visionneuse-suivant
      class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-10 inline-flex items-center justify-center w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white focus:outline-none focus-visible:ring-4 focus-visible:ring-sunset-400"
      aria-label={tr['visionneuse.suivant']}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>
  </div>

  <!-- Tarifs -->
  <section id="tarifs" class="max-w-6xl mx-auto px-4 py-24 scroll-mt-16">
    <p class="text-sunset-600 text-xs font-semibold tracking-[0.25em] uppercase mb-4">
      {tr['tarifs.subtitle']}
    </p>
    <h2 class="font-display text-3xl md:text-5xl font-semibold text-ocean-900">{tr['tarifs.title']}</h2>
    <div class="mt-14 grid md:grid-cols-3 gap-6">
      {tarifsData.saisons.map((saison, i) => (
        <div
          class:list={[
            'rounded-2xl p-8 flex flex-col transition-shadow',
            i === 0
              ? 'bg-ocean-800 text-white shadow-card-hover ring-1 ring-ocean-700'
              : 'bg-white border border-sand-200 shadow-card hover:shadow-card-hover',
          ]}
        >
          <h3 class:list={['font-display text-2xl font-semibold', i === 0 ? 'text-white' : 'text-ocean-800']}>
            {saison.periode}
          </h3>
          <p class="mt-6">
            <span class:list={['font-display text-5xl font-semibold', i === 0 ? 'text-white' : 'text-ocean-900']}>
              {saison.prix_semaine} €
            </span>
            <span class:list={['text-sm ml-2', i === 0 ? 'text-ocean-100/70' : 'text-ocean-700/50']}>
              {tr['tarifs.parSemaine']}
            </span>
          </p>
          <p class:list={['mt-3 text-sm', i === 0 ? 'text-ocean-100/70' : 'text-ocean-700/60']}>
            {saison.prix_nuit_min} € {tr['tarifs.parNuit']} · {saison.nuits_min} {tr['tarifs.nuitsMin']}
          </p>
          <p class:list={['mt-5 pt-5 text-sm border-t', i === 0 ? 'border-ocean-700 text-ocean-100/80' : 'border-sand-200 text-ocean-700/70 italic']}>
            {saison.note}
          </p>
        </div>
      ))}
    </div>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="bg-sand-100 rounded-2xl p-8">
        <h3 class="font-display text-xl font-semibold text-ocean-800 mb-5">{tr['tarifs.inclus']}</h3>
        <ul class="space-y-3 text-ocean-800/80">
          {tarifsData.inclus.map((item) => (
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 text-sunset-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-6 pt-5 border-t border-sand-200 text-sm text-ocean-700/60">
          {tr['tarifs.caution']}: <span class="font-semibold text-ocean-800">{tarifsData.caution} €</span>
        </p>
      </div>
      <div class="bg-white rounded-2xl p-8 border border-sand-200">
        <h3 class="font-display text-xl font-semibold text-ocean-800 mb-5">{tr['tarifs.options']}</h3>
        <ul class="space-y-3 text-ocean-800/80">
