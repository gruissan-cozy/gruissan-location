---
import Layout from '../layouts/Layout.astro';
import { adminT } from '../i18n/admin';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const tr = adminT[lang];

const steps = [
  tr['admin.howto.step1'],
  tr['admin.howto.step2'],
  tr['admin.howto.step3'],
  tr['admin.howto.step4'],
  tr['admin.howto.step5'],
];

const files: Array<{ path: string; desc: string }> = [
  { path: 'content/site.json', desc: tr['admin.files.site'] },
  { path: 'content/tarifs.json', desc: tr['admin.files.tarifs'] },
  { path: 'content/disponibilites.json', desc: tr['admin.files.dispo'] },
  { path: 'content/packs.json', desc: tr['admin.files.packs'] },
  { path: 'content/galerie.json', desc: tr['admin.files.galerie'] },
  { path: 'content/guide.json', desc: tr['admin.files.guide'] },
  { path: 'content/proximite.json', desc: tr['admin.files.proxi'] },
];
---

<Layout lang={lang} title={tr['admin.title']}>
  <section class="max-w-4xl mx-auto px-4 py-16">
    <p class="text-sunset-600 text-xs font-semibold tracking-[0.25em] uppercase mb-4">
      gruissan-cozy
    </p>
    <h1 class="font-display text-4xl md:text-5xl font-semibold text-ocean-900">
      {tr['admin.title']}
    </h1>
    <p class="mt-4 text-lg text-ocean-700/80 max-w-2xl">{tr['admin.subtitle']}</p>

    <!-- Le principe -->
    <div class="mt-12 bg-white rounded-2xl p-8 shadow-card border border-sand-200">
      <h2 class="font-display text-2xl font-semibold text-ocean-800">{tr['admin.howto.title']}</h2>
      <p class="mt-3 text-ocean-700/80 leading-relaxed">{tr['admin.howto.desc']}</p>
      <ol class="mt-6 space-y-3">
        {steps.map((step, i) => (
          <li class="flex gap-4 items-start">
            <span class="shrink-0 w-8 h-8 rounded-full bg-ocean-600 text-white font-semibold flex items-center justify-center text-sm">
              {i + 1}
            </span>
            <p class="text-ocean-800 pt-1">{step}</p>
          </li>
        ))}
      </ol>
    </div>

    <!-- Les fichiers -->
    <div class="mt-8 bg-white rounded-2xl p-8 shadow-card border border-sand-200">
      <h2 class="font-display text-2xl font-semibold text-ocean-800">{tr['admin.files.title']}</h2>
      <ul class="mt-6 space-y-4">
        {files.map((f) => (
          <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 border-b border-sand-100 pb-4 last:border-0 last:pb-0">
            <code class="font-mono text-sm font-semibold text-ocean-600 bg-ocean-50 px-2 py-1 rounded shrink-0">
              {f.path}
            </code>
            <span class="text-ocean-700/80 text-sm">{f.desc}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Messages -->
    <div class="mt-8 bg-sand-100 rounded-2xl p-8">
      <h2 class="font-display text-2xl font-semibold text-ocean-800">{tr['admin.messages.title']}</h2>
      <p class="mt-3 text-ocean-700/80 leading-relaxed">{tr['admin.messages.desc']}</p>
    </div>

    <!-- Photos -->
    <div class="mt-8 bg-white rounded-2xl p-8 shadow-card border border-sand-200">
      <h2 class="font-display text-2xl font-semibold text-ocean-800">{tr['admin.photos.title']}</h2>
      <p class="mt-3 text-ocean-700/80 leading-relaxed">{tr['admin.photos.desc']}</p>
    </div>

    <!-- Bon à savoir -->
    <div class="mt-8 bg-amber-50 rounded-2xl p-8 ring-1 ring-amber-200">
      <h2 class="font-display text-2xl font-semibold text-amber-800">{tr['admin.warn.title']}</h2>
      <p class="mt-3 text-amber-900/80 leading-relaxed">{tr['admin.warn.desc']}</p>
    </div>

    <a
      href={`/gruissan-location/${lang === 'fr' ? '' : lang + '/'}`}
      class="inline-block mt-10 bg-ocean-600 hover:bg-ocean-700 text-white font-semibold px-7 py-3.5 rounded-full transition-colors"
    >
      {tr['admin.back']}
    </a>
  </section>
</Layout>
