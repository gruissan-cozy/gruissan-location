---
/**
 * Espace locataire statique pour GitHub Pages.
 * Le lien de séjour porte un jeton temporaire en query string.
 */
import Layout from '../../layouts/Layout.astro';
import type { Lang } from '../../i18n';
const lang: Lang = 'fr';
---

<Layout lang={lang} title="Espace locataire — Gruissan Cozy">
  <meta name="referrer" content="no-referrer" slot="head" />
  <meta name="robots" content="noindex, nofollow, noarchive" slot="head" />
  <section class="mx-auto max-w-3xl px-4 py-8 sm:py-12">
    <header class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sunset-600">Gruissan Plage</p>
      <h1 id="tenant-title" class="mt-2 font-display text-3xl font-semibold text-ocean-900">Espace locataire</h1>
      <p id="tenant-subtitle" class="mt-2 text-ocean-700/80"></p>
    </header>
    <div id="tenant-root" class="space-y-6" aria-live="polite">
      <p id="tenant-loading" class="text-sm text-ocean-700/70">Chargement…</p>
    </div>
    <p id="tenant-feedback" class="mt-5 hidden rounded-lg p-3 text-sm" role="status"></p>
  </section>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { t, LANGUAGES, type Lang } from '../../i18n';
  import { TENANT_ROOMS, attachTenantSignaturePad, tenantReportPreflight } from '../../lib/tenant';

  (() => {
    const params = new URLSearchParams(window.location.search);
    const token = params.get('token') || '';
    const requestedLang = params.get('lang') || 'fr';
    const lang: Lang = LANGUAGES.includes(requestedLang as Lang) ? requestedLang as Lang : 'fr';
    const tr = t[lang];
    const root = document.getElementById('tenant-root');
    const feedback = document.getElementById('tenant-feedback');
    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
    const rooms = TENANT_ROOMS;
    type Room = (typeof rooms)[number];
    type Moment = 'checkin' | 'checkout';
    type ChecklistRow = { id: string; room: Room; item: string; ok: boolean; note: string | null };
    type Photo = { id: string; room: Room; moment: Moment };
    const roomLabels: Record<Room, string> = {
      living: tr['tenant.room.living'], kitchen: tr['tenant.room.kitchen'],
      bedroom: tr['tenant.room.bedroom'], mezzanine: tr['tenant.room.mezzanine'],
      bathroom: tr['tenant.room.bathroom'], entrance: tr['tenant.room.entrance'],
    };

    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[char] || char);
    const showMessage = (message: string, isError = false) => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.className = `mt-5 rounded-lg p-3 text-sm ${isError ? 'bg-rose-50 text-rose-700' : 'bg-ocean-50 text-ocean-800'}`;
    };
    const fail = (message: string) => {
      if (root) root.innerHTML = `<p class="rounded-xl bg-rose-50 p-4 text-rose-700">${escapeHtml(message)}</p>`;
    };

    const title = document.getElementById('tenant-title');
    const subtitle = document.getElementById('tenant-subtitle');
    if (title) title.textContent = tr['tenant.title'];
    if (subtitle) subtitle.textContent = tr['tenant.subtitle'];
    document.documentElement.lang = lang;

    if (!token || !supabaseUrl || !supabaseAnonKey || !root) {
      fail(tr['tenant.invalid']);
      return;
    }

    const tenantRoot = root as HTMLElement;

    // Garder le jeton en mémoire uniquement, et le retirer de l’adresse affichée.
    params.delete('token');
    const safeQuery = params.toString();
    history.replaceState(null, '', `${window.location.pathname}${safeQuery ? `?${safeQuery}` : ''}`);

    const supabase = createClient(supabaseUrl, supabaseAnonKey, {
      global: { headers: { 'x-tenant-token': token } },
    });
    let reservationId = '';
    let moment: Moment = 'checkin';
    let checklist: ChecklistRow[] = [];
    let photos: Photo[] = [];
    let signaturePad: ReturnType<typeof attachTenantSignaturePad> | null = null;
    const pendingSaves = new Set<Promise<void>>();
    const pendingReports: Partial<Record<Moment, string>> = {};
    const completedMoments = new Set<Moment>();

    const edgeCall = async (functionName: string, body: Record<string, unknown>) => {
      const { data, error } = await supabase.functions.invoke(functionName, { body });
      if (error) throw new Error(tr['tenant.serverError']);
      return data;
    };

    function safeGuideFragment(html: string): DocumentFragment {
      const parsed = new DOMParser().parseFromString(html, 'text/html');
      const fragment = document.createDocumentFragment();
      const allowedTags = new Set(['P', 'STRONG', 'EM', 'B', 'I', 'UL', 'OL', 'LI', 'BR', 'H3', 'H4', 'A']);
      const copy = (source: Node, target: Node) => {
        if (source.nodeType === Node.TEXT_NODE) {
          target.appendChild(document.createTextNode(source.textContent || ''));
          return;
        }
        if (!(source instanceof HTMLElement) || !allowedTags.has(source.tagName)) {
          source.childNodes.forEach((child) => copy(child, target));
          return;
        }
        const node = document.createElement(source.tagName.toLowerCase());
        if (source.tagName === 'A') {
          const href = source.getAttribute('href') || '';
          if (/^https?:\/\//i.test(href)) {
            node.setAttribute('href', href);
            node.setAttribute('rel', 'noopener noreferrer');
            node.setAttribute('target', '_blank');
          }
        }
        source.childNodes.forEach((child) => copy(child, node));
        target.appendChild(node);
      };
      parsed.body.childNodes.forEach((child) => copy(child, fragment));
      return fragment;
    }

    async function loadGuide() {
      const container = document.getElementById('tenant-guide');
      if (!container) return;
      const { data, error } = await supabase.from('guide_sections')
        .select('slug, titre, contenu, icone, ordre').eq('actif', true).order('ordre');
      if (error || !data?.length) {
        container.textContent = tr['tenant.guideUnavailable'];
        return;
      }
      container.replaceChildren(...data.map((section) => {
        const article = document.createElement('article');
        article.className = 'rounded-xl border border-sand-200 bg-white p-4 shadow-card';
        const heading = document.createElement('h3');
        heading.className = 'mb-2 font-display text-lg font-semibold text-ocean-900';
        const titles = section.titre as Record<string, string>;
        heading.textContent = `${section.icone || '📄'} ${titles?.[lang] || titles?.fr || section.slug}`;
        const content = document.createElement('div');
        content.className = 'space-y-2 text-sm leading-relaxed text-ocean-800/90';
        const bodies = section.contenu as Record<string, string>;
        content.appendChild(safeGuideFragment(bodies?.[lang] || bodies?.fr || ''));
        article.append(heading, content);
        return article;
      }));
    }

    async function signedPhotoUrl(photoId: string): Promise<string> {
      const data = await edgeCall('tenant-upload', { action: 'sign', photoId });
      return data.url as string;
    }

    async function loadMoment(nextMoment: Moment) {
      moment = nextMoment;
      signaturePad?.destroy();
      signaturePad = null;
      const { data, error } = await supabase.from('checklists')
        .select('id, room, item, ok, note').eq('reservation_id', reservationId)
        .eq('moment', moment).order('room');
      if (error) throw error;
      const rows = (data || []) as ChecklistRow[];
      const missing = rooms.filter((room) => !rows.some((row) => row.room === room && row.item === 'condition'));
      if (missing.length) {
        const { error: seedError } = await supabase.from('checklists').upsert(missing.map((room) => ({
          reservation_id: reservationId, moment, room, item: 'condition', ok: false,
        })), { onConflict: 'reservation_id,moment,room,item' });
        if (seedError) throw seedError;
      }
      const refreshed = missing.length
        ? await supabase.from('checklists').select('id, room, item, ok, note')
          .eq('reservation_id', reservationId).eq('moment', moment).order('room')
        : { data: rows, error: null };
      if (refreshed.error) throw refreshed.error;
      checklist = (refreshed.data || []) as ChecklistRow[];
      const photoResult = await supabase.from('photos').select('id, room, moment')
        .eq('reservation_id', reservationId).eq('moment', moment).order('created_at');
      if (photoResult.error) throw photoResult.error;
      photos = (photoResult.data || []) as Photo[];
      await renderPanel();
    }

    async function compressImage(file: File): Promise<string> {
      if (!file.type.startsWith('image/') || file.size > 12_000_000) throw new Error('invalid image');
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, 1400 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(bitmap.width * scale));
      canvas.height = Math.max(1, Math.round(bitmap.height * scale));
      const context = canvas.getContext('2d');
      if (!context) throw new Error('canvas unavailable');
      context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      const dataUrl = canvas.toDataURL('image/jpeg', 0.68);
      if (dataUrl.length > 2_100_000) throw new Error('compressed image too large');
      return dataUrl;
    }

    async function renderPanel() {
      const activeLabel = moment === 'checkin' ? tr['tenant.checkin'] : tr['tenant.checkout'];
      tenantRoot.innerHTML = `
        <section class="rounded-2xl border border-sand-200 bg-white p-5 shadow-card sm:p-7">
          <h2 class="font-display text-2xl font-semibold text-ocean-900">${escapeHtml(tr['tenant.guide'])}</h2>
          <div id="tenant-guide" class="mt-4 space-y-3"><p class="text-sm text-ocean-700/70">…</p></div>
        </section>
        <section class="rounded-2xl border border-sand-200 bg-white p-5 shadow-card sm:p-7">
          <div class="flex flex-wrap gap-2" role="tablist">
            <button type="button" data-moment="checkin" role="tab" aria-selected="${moment === 'checkin'}" class="min-h-11 rounded-full px-4 py-2 text-sm font-semibold ${moment === 'checkin' ? 'bg-ocean-800 text-white' : 'border border-ocean-200 text-ocean-800'}">${escapeHtml(tr['tenant.checkin'])}</button>
            <button type="button" data-moment="checkout" role="tab" aria-selected="${moment === 'checkout'}" class="min-h-11 rounded-full px-4 py-2 text-sm font-semibold ${moment === 'checkout' ? 'bg-ocean-800 text-white' : 'border border-ocean-200 text-ocean-800'}">${escapeHtml(tr['tenant.checkout'])}</button>
          </div>
          <h2 class="mt-5 font-display text-2xl font-semibold text-ocean-900">${escapeHtml(activeLabel)}</h2>
          <div id="tenant-rooms" class="mt-5 space-y-4"></div>
          <div class="mt-8">
            <h3 class="font-display text-xl font-semibold text-ocean-900">${escapeHtml(tr['tenant.signature'])}</h3>
            <canvas id="tenant-signature" aria-label="${escapeHtml(tr['tenant.signature'])}" class="mt-3 h-40 w-full touch-none rounded-xl border border-sand-300 bg-white"></canvas>
            <button type="button" id="tenant-clear-signature" class="mt-2 min-h-11 rounded-full border border-ocean-300 px-4 py-2 text-sm font-medium text-ocean-800">${escapeHtml(tr['tenant.signature.clear'])}</button>
          </div>
          <button type="button" id="tenant-submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-sunset-500 px-6 py-3 text-sm font-semibold text-white hover:bg-sunset-600">${escapeHtml(tr['tenant.submit'])}</button>
        </section>`;
      tenantRoot.querySelectorAll<HTMLButtonElement>('[data-moment]').forEach((button) => {
        button.addEventListener('click', () => void loadMoment(button.dataset.moment as Moment).catch(() => showMessage(tr['tenant.loadingError'], true)));
      });
      await loadGuide();
      await renderRooms();
      initSignature();
      document.getElementById('tenant-clear-signature')?.addEventListener('click', clearSignature);
      document.getElementById('tenant-submit')?.addEventListener('click', submitReport);
    }

    async function renderRooms() {
      const container = document.getElementById('tenant-rooms');
      if (!container) return;
      container.replaceChildren();
      for (const room of rooms) {
        const row = checklist.find((entry) => entry.room === room && entry.item === 'condition');
        if (!row) continue;
        const card = document.createElement('article');
        card.className = 'rounded-xl border border-sand-200 bg-sand-50 p-4';
        card.innerHTML = `
          <h3 class="font-display text-lg font-semibold text-ocean-900">${escapeHtml(roomLabels[room])}</h3>
          <label class="mt-3 flex min-h-11 items-center gap-3 text-sm text-ocean-800">
            <input type="checkbox" data-ok class="h-5 w-5 rounded border-sand-300 text-ocean-700" ${row.ok ? 'checked' : ''} />
            <span>${escapeHtml(tr['tenant.condition'])} — ${escapeHtml(tr['tenant.ok'])}</span>
          </label>
          <label class="mt-2 block text-sm text-ocean-700">${escapeHtml(tr['tenant.problem'])}
            <input data-note type="text" maxlength="300" value="${escapeHtml(row.note || '')}" class="mt-1 min-h-11 w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-ocean-900" />
          </label>
          <div data-preview class="mt-3 hidden"></div>
          <input data-file type="file" accept="image/*" capture="environment" class="sr-only" />
          <button type="button" data-add class="mt-3 inline-flex min-h-11 items-center justify-center rounded-full border border-ocean-300 bg-white px-4 py-2 text-sm font-semibold text-ocean-800">${escapeHtml(tr['tenant.addPhoto'])}</button>
          <h4 class="mt-4 text-sm font-semibold text-ocean-800">${escapeHtml(tr['tenant.photos'])}</h4>
          <div data-gallery class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-3"></div>`;
        container.appendChild(card);

        const checkbox = card.querySelector<HTMLInputElement>('[data-ok]')!;
        const noteInput = card.querySelector<HTMLInputElement>('[data-note]')!;
        const fileInput = card.querySelector<HTMLInputElement>('[data-file]')!;
        const preview = card.querySelector<HTMLDivElement>('[data-preview]')!;
        const gallery = card.querySelector<HTMLDivElement>('[data-gallery]')!;
        let saveQueue: Promise<void> = Promise.resolve();
        const saveChecklist = () => {
          const values = { ok: checkbox.checked, note: noteInput.value.trim() || null };
          saveQueue = saveQueue.then(async () => {
            showMessage(tr['tenant.saving']);
            try {
              const { error } = await supabase.from('checklists').update(values).eq('id', row.id);
              if (error) {
                showMessage(tr['tenant.serverError'], true);
                return;
              }
              checklist = checklist.map((entry) => entry.id === row.id ? { ...entry, ...values } : entry);
              showMessage(tr['tenant.saved']);
            } catch {
              showMessage(tr['tenant.loadingError'], true);
            }
          });
          const operation = saveQueue;
          pendingSaves.add(operation);
          void operation.finally(() => pendingSaves.delete(operation));
          return operation;
        };
        checkbox.addEventListener('change', () => void saveChecklist());
        noteInput.addEventListener('change', () => void saveChecklist());
        card.querySelector('[data-add]')?.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', () => {
          const file = fileInput.files?.[0];
          if (!file) return;
          if (photos.filter((photo) => photo.room === room).length >= 2) {
            showMessage(tr['tenant.photoLimit'], true);
            fileInput.value = '';
            return;
          }
          const objectUrl = URL.createObjectURL(file);
          preview.classList.remove('hidden');
          preview.innerHTML = `<img src="${objectUrl}" alt="${escapeHtml(roomLabels[room])}" class="max-h-64 w-full rounded-lg object-cover" />
            <div class="mt-2 flex gap-2"><button type="button" data-confirm class="min-h-11 rounded-full bg-ocean-800 px-4 py-2 text-sm font-semibold text-white">${escapeHtml(tr['tenant.confirmPhoto'])}</button>
            <button type="button" data-retake class="min-h-11 rounded-full border border-ocean-300 px-4 py-2 text-sm">${escapeHtml(tr['tenant.photo.retake'])}</button></div>`;
          preview.querySelector('[data-retake]')?.addEventListener('click', () => {
            URL.revokeObjectURL(objectUrl);
            fileInput.value = '';
            preview.classList.add('hidden');
            preview.replaceChildren();
          });
          preview.querySelector('[data-confirm]')?.addEventListener('click', async () => {
            const button = preview.querySelector<HTMLButtonElement>('[data-confirm]');
            if (button) { button.disabled = true; button.textContent = tr['tenant.uploading']; }
            try {
              const dataUrl = await compressImage(file);
              const result = await edgeCall('tenant-upload', { action: 'upload', moment, room, dataUrl });
              photos.push(result.photo as Photo);
              URL.revokeObjectURL(objectUrl);
              fileInput.value = '';
              preview.classList.add('hidden');
              preview.replaceChildren();
              await drawGallery(room, gallery);
              showMessage(tr['tenant.saved']);
            } catch {
              showMessage(tr['tenant.photoError'], true);
              if (button) { button.disabled = false; button.textContent = tr['tenant.confirmPhoto']; }
            }
          });
        });
        await drawGallery(room, gallery);
      }
    }

    async function drawGallery(room: Room, gallery: HTMLDivElement) {
      gallery.replaceChildren();
      for (const photo of photos.filter((entry) => entry.room === room && entry.moment === moment)) {
        const url = await signedPhotoUrl(photo.id).catch(() => '');
        if (!url) continue;
        const figure = document.createElement('figure');
        const image = document.createElement('img');
        image.src = url;
        image.alt = roomLabels[room];
        image.loading = 'lazy';
        image.className = 'h-28 w-full rounded-lg object-cover';
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = tr['tenant.photo.remove'];
        button.className = 'mt-1 min-h-10 w-full rounded-full border border-rose-200 bg-white px-3 py-1 text-xs text-rose-700';
        button.addEventListener('click', async () => {
          button.disabled = true;
          try {
            await edgeCall('tenant-upload', { action: 'delete', photoId: photo.id });
            photos = photos.filter((entry) => entry.id !== photo.id);
            await drawGallery(room, gallery);
          } catch {
            button.disabled = false;
            showMessage(tr['tenant.loadingError'], true);
          }
        });
        figure.append(image, button);
        gallery.appendChild(figure);
      }
    }

    function initSignature() {
      signaturePad?.destroy();
      const canvas = document.getElementById('tenant-signature') as HTMLCanvasElement | null;
      const context = canvas?.getContext('2d');
      signaturePad = canvas && context ? attachTenantSignaturePad(canvas, context) : null;
    }

    function clearSignature() {
      signaturePad?.clear();
    }

    async function submitReport() {
      if (completedMoments.has(moment)) {
        showMessage(tr['tenant.success']);
        return;
      }
      if (pendingSaves.size) await Promise.all([...pendingSaves]);
      const preflight = tenantReportPreflight(checklist, photos, moment, Boolean(signaturePad?.hasSignature) || Boolean(pendingReports[moment]));
      if (preflight === 'assessment') {
        showMessage(tr['tenant.assessmentRequired'], true);
        return;
      }
      if (preflight === 'photos') {
        showMessage(tr['tenant.photosRequired'], true);
        return;
      }
      if (preflight === 'signature') {
        showMessage(tr['tenant.signatureRequired'], true);
        return;
      }
      if (!window.confirm(tr['tenant.confirm'])) return;
      const button = document.getElementById('tenant-submit') as HTMLButtonElement | null;
      if (button) { button.disabled = true; button.textContent = tr['tenant.saving']; }
      try {
        let signedUrl = pendingReports[moment];
        if (!signedUrl) {
          const canvas = document.getElementById('tenant-signature') as HTMLCanvasElement;
          const generated = await edgeCall('generate-pdf', {
            reservation_id: reservationId, moment, signature: canvas.toDataURL('image/png'),
          });
          if (!generated?.ok || typeof generated.signedUrl !== 'string') throw new Error(tr['tenant.serverError']);
          signedUrl = generated.signedUrl;
          pendingReports[moment] = signedUrl;
        }
        if (!signedUrl) throw new Error(tr['tenant.serverError']);
        await edgeCall('send-email', { reservation_id: reservationId, moment });
        delete pendingReports[moment];
        completedMoments.add(moment);
        showMessage(tr['tenant.success']);
        const link = document.createElement('a');
        link.href = signedUrl;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.className = 'mt-2 inline-block font-semibold underline';
        link.textContent = tr['tenant.downloadReport'];
        feedback?.append(document.createElement('br'), link);
      } catch {
        if (pendingReports[moment]) showMessage(tr['tenant.emailPartial'], true);
        else showMessage(tr['tenant.loadingError'], true);
      } finally {
        if (button) { button.disabled = false; button.textContent = tr['tenant.submit']; }
      }
    }

    async function init() {
      try {
        const { data: session, error } = await supabase.from('tenant_sessions')
          .select('id, reservation_id, expires_at').eq('token', token).maybeSingle();
        if (error || !session || new Date(session.expires_at).getTime() <= Date.now()) {
          fail(tr['tenant.invalid']);
          return;
        }
        reservationId = session.reservation_id;
        await loadMoment('checkin');
      } catch {
        fail(tr['tenant.loadingError']);
      }
    }

    void init();
  })();
</script>
