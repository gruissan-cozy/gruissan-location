---
/**
 * /admin/packs — CRUD complet de la table `packs`.
 *
 * Liste triée par `ordre`, formulaire de création / édition (slug, nom et
 * description en 4 langues, prix, unité, actif, ordre), suppression et
 * bascule actif / inactif.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isSupabaseConfigured } from '../../lib/supabase';
import { AT } from '../../i18n/admin';

const configured = isSupabaseConfigured;

const LANGS = ['fr', 'en', 'es', 'de'] as const;
const UNITS = ['par_personne', 'par_sejour', 'par_nuit'] as const;
---

<AdminLayout title={AT['packs.title']} section="packs">
  {
    configured && (
      <>
        <header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h1 class="font-display text-2xl font-semibold text-ocean-900 sm:text-3xl">
              {AT['packs.title']}
            </h1>
            <p class="mt-1.5 text-sm text-ocean-700/80">{AT['packs.subtitle']}</p>
          </div>
          <div class="flex items-center gap-3">
            <p id="packs-count" class="text-sm text-ocean-700/70"></p>
            <button
              id="packs-new"
              type="button"
              class="rounded-full bg-sunset-500 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-sunset-600"
            >
              {AT['packs.new']}
            </button>
          </div>
        </header>

        <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(0,26rem)]">
          <!-- ===== Liste ===== -->
          <div class="overflow-hidden rounded-2xl border border-sand-200/70 bg-white shadow-card">
            <div class="overflow-x-auto">
              <table class="w-full min-w-[36rem] border-collapse">
                <thead class="bg-sand-50">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['packs.colName']}
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['packs.colPrice']}
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['common.order']}
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['packs.colStatus']}
                    </th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['packs.colActions']}
                    </th>
                  </tr>
                </thead>
                <tbody id="packs-list" class="divide-y divide-sand-200/70">
                  <tr>
                    <td colspan="5" class="px-4 py-6 text-sm text-ocean-700/60">{AT['common.loading']}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- ===== Formulaire ===== -->
          <div id="packs-form-panel" class="hidden rounded-2xl border border-sand-200/70 bg-white p-5 shadow-card sm:p-6">
            <div class="flex items-start justify-between gap-3">
              <h2 id="packs-form-title" class="font-display text-lg font-semibold text-ocean-900">
                {AT['packs.createTitle']}
              </h2>
              <button
                id="packs-form-close"
                type="button"
                class="rounded-full p-1.5 text-ocean-700/60 transition-colors hover:bg-sand-50 hover:text-ocean-800"
                aria-label={AT['common.close']}
              >
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <form id="packs-form" class="mt-4 space-y-4" novalidate>
              <input type="hidden" id="pack-id" />

              <div>
                <label class="block text-sm font-medium text-ocean-800 mb-1.5" for="pack-slug">
                  Identifiant (slug)
                </label>
                <input
                  id="pack-slug"
                  type="text"
                  required
                  placeholder="pack-plage"
                  class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-sm text-ocean-900 placeholder:text-ocean-700/35 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                />
                <p class="mt-1 text-xs text-ocean-700/55">Lettres minuscules, chiffres et tirets.</p>
                <p id="err-slug" class="mt-1 hidden text-xs text-rose-700"></p>
              </div>

              <!-- Nom multilingue -->
              <fieldset>
                <legend class="mb-2 block text-sm font-medium text-ocean-800">Nom</legend>
                <div class="space-y-2">
                  {
                    LANGS.map((l) => (
                      <div class="flex items-center gap-2">
                        <span class="w-9 shrink-0 text-xs font-semibold uppercase text-ocean-700/60">{l}</span>
                        <input
                          id={`pack-nom-${l}`}
                          type="text"
                          data-lang={l}
                          class="pack-nom w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-sm text-ocean-900 placeholder:text-ocean-700/35 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                        />
                      </div>
                    ))
                  }
                </div>
                <p id="err-nom" class="mt-1 hidden text-xs text-rose-700"></p>
              </fieldset>

              <!-- Description multilingue -->
              <fieldset>
                <legend class="mb-2 block text-sm font-medium text-ocean-800">Description</legend>
                <div class="space-y-2">
                  {
                    LANGS.map((l) => (
                      <div>
                        <span class="mb-1 block text-xs font-semibold uppercase text-ocean-700/55">{l}</span>
                        <textarea
                          id={`pack-desc-${l}`}
                          data-lang={l}
                          rows="2"
                          class="pack-desc w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-sm leading-relaxed text-ocean-900 placeholder:text-ocean-700/35 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                        ></textarea>
                      </div>
                    ))
                  }
                </div>
              </fieldset>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-ocean-800 mb-1.5" for="pack-prix">
                    {AT['common.price']} (€)
                  </label>
                  <input
                    id="pack-prix"
                    type="number"
                    min="0"
                    step="0.01"
                    required
                    class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-sm text-ocean-900 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                  />
                  <p id="err-prix" class="mt-1 hidden text-xs text-rose-700"></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-ocean-800 mb-1.5" for="pack-unite">
                    {AT['common.unit']}
                  </label>
                  <select
                    id="pack-unite"
                    class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-sm text-ocean-900 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                  >
                    {
                      UNITS.map((u) => (
                        <option value={u}>{AT[`unit.${u}`]}</option>
                      ))
                    }
                  </select>
                </div>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-ocean-800 mb-1.5" for="pack-ordre">
                    {AT['common.order']}
                  </label>
                  <input
                    id="pack-ordre"
                    type="number"
                    step="1"
                    value="0"
                    class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-sm text-ocean-900 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                  />
                </div>
                <div class="flex items-end">
                  <label class="flex items-center gap-2 pb-2 text-sm text-ocean-800">
                    <input id="pack-actif" type="checkbox" checked class="h-4 w-4 rounded border-sand-300 text-ocean-600 focus:ring-ocean-200" />
                    {AT['common.active']}
                  </label>
                </div>
              </div>

              <p id="packs-form-error" class="hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700 ring-1 ring-rose-200"></p>

              <div class="flex flex-wrap items-center justify-end gap-2 border-t border-sand-200/70 pt-4">
                <button
                  id="packs-form-delete"
                  type="button"
                  class="hidden rounded-full border border-rose-200 bg-white px-4 py-2 text-sm font-medium text-rose-700 transition-colors hover:bg-rose-50"
                >
                  {AT['common.delete']}
                </button>
                <button
                  id="packs-form-cancel"
                  type="button"
                  class="rounded-full border border-sand-300 bg-white px-4 py-2 text-sm font-medium text-ocean-800 transition-colors hover:bg-sand-50"
                >
                  {AT['common.cancel']}
                </button>
                <button
                  type="submit"
                  class="rounded-full bg-sunset-500 px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-sunset-600 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  {AT['common.save']}
                </button>
              </div>
            </form>
          </div>
        </div>
      </>
    )
  }
</AdminLayout>

{
  configured && (
    <script>
      import { sb, CLS, esc, fmtPrice, toast, errText } from '../../lib/admin-runtime';
      import { AT } from '../../i18n/admin';
      import type { Pack } from '../../lib/supabase';

      const LANGS = ['fr', 'en', 'es', 'de'] as const;

      let packs: Pack[] = [];
      let editingId: string | null = null;

      const listEl = document.getElementById('packs-list');
      const panel = document.getElementById('packs-form-panel');
      const formTitle = document.getElementById('packs-form-title');
      const form = document.getElementById('packs-form') as HTMLFormElement | null;
      const formError = document.getElementById('packs-form-error');
      const deleteBtn = document.getElementById('packs-form-delete');
      const countEl = document.getElementById('packs-count');

      const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null);
      /** Case à cocher typée (les `input[type=checkbox]` ont `.checked`). */
      const chk = (id: string) => document.getElementById(id) as HTMLInputElement | null;
      const showErr = (id: string, message: string) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = message;
        el.classList.toggle('hidden', !message);
      };

      // -----------------------------------------------------------------
      // Chargement
      // -----------------------------------------------------------------
      async function load() {
        const { data, error } = await sb().from('packs').select('*').order('ordre', { ascending: true });
        if (error) {
          toast(errText(error) || AT['common.errorGeneric'], 'error');
          return;
        }
        packs = (data ?? []) as Pack[];
        renderList();
      }

      function renderList() {
        if (!listEl) return;
        if (!packs.length) {
          listEl.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-sm text-ocean-700/60">${esc(AT['packs.empty'])}</td></tr>`;
        } else {
          listEl.innerHTML = packs
            .map((p) => {
              const nom = p.nom?.fr || p.nom?.en || Object.values(p.nom ?? {})[0] || '—';
              return `
              <tr class="transition-colors hover:bg-sand-50/70">
                <td class="px-4 py-3 align-top">
                  <button
                    type="button"
                    data-edit="${esc(p.id)}"
                    class="text-left text-sm font-semibold text-ocean-900 underline-offset-2 hover:text-ocean-600 hover:underline"
                  >${esc(nom)}</button>
                  <span class="mt-0.5 block text-xs text-ocean-700/50">${esc(p.slug)}</span>
                </td>
                <td class="px-4 py-3 align-top text-sm whitespace-nowrap text-ocean-900">
                  ${esc(fmtPrice(p.prix))}
                  <span class="ml-1 text-xs text-ocean-700/55">${esc(AT[`unit.${p.unite}`] ?? p.unite)}</span>
                </td>
                <td class="px-4 py-3 align-top text-sm text-ocean-700/80">${esc(String(p.ordre ?? 0))}</td>
                <td class="px-4 py-3 align-top">
                  <button
                    type="button"
                    data-toggle="${esc(p.id)}"
                    title="${esc(p.actif ? AT['common.deactivate'] : AT['common.activate'])}"
                    class="${
                      p.actif
                        ? 'bg-emerald-50 text-emerald-700 ring-emerald-200'
                        : 'bg-sand-100 text-ocean-700/70 ring-sand-300'
                    } ${CLS.badge} transition-colors hover:opacity-80"
                  >${esc(p.actif ? AT['common.active'] : AT['common.inactive'])}</button>
                </td>
                <td class="px-4 py-3 align-top">
                  <div class="flex items-center justify-end gap-1.5">
                    <button
                      type="button"
                      data-edit="${esc(p.id)}"
                      class="rounded-full border border-sand-300 bg-white px-3 py-1.5 text-xs font-medium text-ocean-800 transition-colors hover:bg-sand-50"
                    >${esc(AT['common.edit'])}</button>
                    <button
                      type="button"
                      data-remove="${esc(p.id)}"
                      class="rounded-full border border-rose-200 bg-white px-3 py-1.5 text-xs font-medium text-rose-700 transition-colors hover:bg-rose-50"
                    >${esc(AT['common.delete'])}</button>
                  </div>
                </td>
              </tr>`;
            })
            .join('');
        }
        if (countEl) countEl.textContent = `${packs.length} ${AT['packs.count']}`;
      }

      // -----------------------------------------------------------------
      // Formulaire
      // -----------------------------------------------------------------
      function openForm(pack?: Pack) {
        editingId = pack?.id ?? null;
        if (formTitle) formTitle.textContent = pack ? AT['packs.editTitle'] : AT['packs.createTitle'];
        if (deleteBtn) deleteBtn.classList.toggle('hidden', !pack);
        if (formError) formError.classList.add('hidden');
        ['err-slug', 'err-nom', 'err-prix'].forEach((id) => showErr(id, ''));

        const id = val('pack-id');
        const slug = val('pack-slug');
        const prix = val('pack-prix');
        const unite = val('pack-unite');
        const ordre = val('pack-ordre');
        const actif = chk('pack-actif');
        if (id) id.value = pack?.id ?? '';
        if (slug) slug.value = pack?.slug ?? '';
        if (prix) prix.value = pack ? String(pack.prix) : '';
        if (unite) unite.value = pack?.unite ?? 'par_sejour';
        if (ordre) ordre.value = pack ? String(pack.ordre) : '0';
        if (actif) actif.checked = pack ? pack.actif : true;

        for (const l of LANGS) {
          const nom = val(`pack-nom-${l}`);
          const desc = val(`pack-desc-${l}`);
          if (nom) nom.value = pack?.nom?.[l] ?? '';
          if (desc) desc.value = pack?.description?.[l] ?? '';
        }

        panel?.classList.remove('hidden');
        panel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function closeForm() {
        editingId = null;
        panel?.classList.add('hidden');
        form?.reset();
      }

      const slugify = (s: string) =>
        s
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        ['err-slug', 'err-nom', 'err-prix'].forEach((id) => showErr(id, ''));
        if (formError) formError.classList.add('hidden');

        const slug = slugify(val('pack-slug')?.value ?? '');
        const nom: Record<string, string> = {};
        const description: Record<string, string> = {};
        for (const l of LANGS) {
          nom[l] = (val(`pack-nom-${l}`)?.value ?? '').trim();
          description[l] = (val(`pack-desc-${l}`)?.value ?? '').trim();
        }
        const prix = Number(val('pack-prix')?.value);
        const unite = (val('pack-unite')?.value ?? 'par_sejour') as Pack['unite'];
        const ordre = Number(val('pack-ordre')?.value ?? 0);
        const actif = Boolean(chk('pack-actif')?.checked);

        let invalid = false;
        if (!slug || !/^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) {
          showErr('err-slug', AT['packs.slugInvalid']);
          invalid = true;
        }
        if (!nom.fr) {
          showErr('err-nom', AT['packs.nameRequired']);
          invalid = true;
        }
        if (!Number.isFinite(prix) || prix < 0) {
          showErr('err-prix', AT['packs.priceInvalid']);
          invalid = true;
        }
        if (invalid) return;

        const payload = {
          slug,
          nom,
          description,
          prix,
          unite,
          ordre: Number.isFinite(ordre) ? ordre : 0,
          actif,
        };

        const { error } = editingId
          ? await sb().from('packs').update(payload).eq('id', editingId)
          : await sb().from('packs').insert(payload);

        if (error) {
          const message = errText(error);
          if (formError) {
            formError.textContent = message;
            formError.classList.remove('hidden');
          }
          toast(message || AT['common.errorGeneric'], 'error');
          return;
        }

        toast(AT['packs.saved']);
        closeForm();
        await load();
      });

      deleteBtn?.addEventListener('click', async () => {
        if (!editingId) return;
        if (!window.confirm(`${AT['packs.confirmDelete']} ${AT['common.irreversible']}`)) return;
        const { error } = await sb().from('packs').delete().eq('id', editingId);
        if (error) {
          toast(errText(error) || AT['common.errorGeneric'], 'error');
          return;
        }
        toast(AT['packs.deleted']);
        closeForm();
        await load();
      });

      // -----------------------------------------------------------------
      // Interactions de la liste
      // -----------------------------------------------------------------
      listEl?.addEventListener('click', async (event) => {
        const target = event.target as HTMLElement;

        const editBtn = target.closest<HTMLElement>('[data-edit]');
        if (editBtn) {
          const pack = packs.find((p) => p.id === editBtn.dataset.edit);
          if (pack) openForm(pack);
          return;
        }

        const toggleBtn = target.closest<HTMLElement>('[data-toggle]');
        if (toggleBtn) {
          const pack = packs.find((p) => p.id === toggleBtn.dataset.toggle);
          if (!pack) return;
          const { error } = await sb()
            .from('packs')
            .update({ actif: !pack.actif })
            .eq('id', pack.id);
          if (error) {
            toast(errText(error) || AT['common.errorGeneric'], 'error');
            return;
          }
          toast(AT['packs.toggled']);
          await load();
          return;
        }

        const removeBtn = target.closest<HTMLElement>('[data-remove]');
        if (removeBtn) {
          const pack = packs.find((p) => p.id === removeBtn.dataset.remove);
          if (!pack) return;
          if (!window.confirm(`${AT['packs.confirmDelete']} ${AT['common.irreversible']}`)) return;
          const { error } = await sb().from('packs').delete().eq('id', pack.id);
          if (error) {
            toast(errText(error) || AT['common.errorGeneric'], 'error');
            return;
          }
          toast(AT['packs.deleted']);
          await load();
        }
      });

      document.getElementById('packs-new')?.addEventListener('click', () => openForm());
      document.getElementById('packs-form-close')?.addEventListener('click', closeForm);
      document.getElementById('packs-form-cancel')?.addEventListener('click', closeForm);

      void load();
    </script>
  )
}
