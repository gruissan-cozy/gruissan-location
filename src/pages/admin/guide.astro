---
/**
 * /admin/guide — CRUD de `guide_sections`.
 *
 * Liste triée par `ordre`, formulaire de création / édition (slug, titre en
 * 4 langues, contenu HTML en 4 langues via textarea, icône emoji, ordre,
 * actif), suppression et bascule actif / inactif. Un aperçu du contenu HTML
 * français est rendu dans une iframe isolée.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isSupabaseConfigured } from '../../lib/supabase';
import { AT } from '../../i18n/admin';

const configured = isSupabaseConfigured;

const LANGS = ['fr', 'en', 'es', 'de'] as const;
---

<AdminLayout title={AT['guide.title']} section="guide">
  {
    configured && (
      <>
        <header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h1 class="font-display text-2xl font-semibold text-ocean-900 sm:text-3xl">
              {AT['guide.title']}
            </h1>
            <p class="mt-1.5 text-sm text-ocean-700/80">{AT['guide.subtitle']}</p>
          </div>
          <div class="flex items-center gap-3">
            <p id="guide-count" class="text-sm text-ocean-700/70"></p>
            <button
              id="guide-new"
              type="button"
              class="rounded-full bg-sunset-500 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-sunset-600"
            >
              {AT['guide.new']}
            </button>
          </div>
        </header>

        <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(0,30rem)]">
          <!-- ===== Liste ===== -->
          <div class="overflow-hidden rounded-2xl border border-sand-200/70 bg-white shadow-card">
            <div class="overflow-x-auto">
              <table class="w-full min-w-[34rem] border-collapse">
                <thead class="bg-sand-50">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['guide.colTitle']}
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['guide.colSlug']}
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['guide.colOrder']}
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['packs.colStatus']}
                    </th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-ocean-700/70">
                      {AT['guide.colActions']}
                    </th>
                  </tr>
                </thead>
                <tbody id="guide-list" class="divide-y divide-sand-200/70">
                  <tr>
                    <td colspan="5" class="px-4 py-6 text-sm text-ocean-700/60">{AT['common.loading']}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- ===== Formulaire ===== -->
          <div id="guide-form-panel" class="hidden rounded-2xl border border-sand-200/70 bg-white p-5 shadow-card sm:p-6">
            <div class="flex items-start justify-between gap-3">
              <h2 id="guide-form-title" class="font-display text-lg font-semibold text-ocean-900">
                {AT['guide.createTitle']}
              </h2>
              <button
                id="guide-form-close"
                type="button"
                class="rounded-full p-1.5 text-ocean-700/60 transition-colors hover:bg-sand-50 hover:text-ocean-800"
                aria-label={AT['common.close']}
              >
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <form id="guide-form" class="mt-4 space-y-4" novalidate>
              <input type="hidden" id="guide-id" />

              <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_5.5rem]">
                <div>
                  <label class="block text-sm font-medium text-ocean-800 mb-1.5" for="guide-slug">
                    Identifiant (slug)
                  </label>
                  <input
                    id="guide-slug"
                    type="text"
                    required
                    placeholder="wifi"
                    class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-sm text-ocean-900 placeholder:text-ocean-700/35 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                  />
                  <p id="err-gslug" class="mt-1 hidden text-xs text-rose-700"></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-ocean-800 mb-1.5" for="guide-icone">
                    Icône
                  </label>
                  <input
                    id="guide-icone"
                    type="text"
                    maxlength="4"
                    placeholder="📶"
                    class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-center text-lg focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                  />
                </div>
              </div>

              <!-- Titre multilingue -->
              <fieldset>
                <legend class="mb-2 block text-sm font-medium text-ocean-800">Titre</legend>
                <div class="space-y-2">
                  {
                    LANGS.map((l) => (
                      <div class="flex items-center gap-2">
                        <span class="w-9 shrink-0 text-xs font-semibold uppercase text-ocean-700/60">{l}</span>
                        <input
                          id={`guide-titre-${l}`}
                          type="text"
                          class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-sm text-ocean-900 placeholder:text-ocean-700/35 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                        />
                      </div>
                    ))
                  }
                </div>
                <p id="err-gtitre" class="mt-1 hidden text-xs text-rose-700"></p>
              </fieldset>

              <!-- Contenu HTML multilingue -->
              <fieldset>
                <legend class="mb-1 block text-sm font-medium text-ocean-800">Contenu HTML</legend>
                <p class="mb-2 text-xs text-ocean-700/55">{AT['guide.htmlHelp']}</p>
                <div class="space-y-3">
                  {
                    LANGS.map((l) => (
                      <div>
                        <label class="mb-1 block text-xs font-semibold uppercase text-ocean-700/55" for={`guide-contenu-${l}`}>
                          {l}
                        </label>
                        <textarea
                          id={`guide-contenu-${l}`}
                          data-lang={l}
                          rows="5"
                          spellcheck="false"
                          class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2 font-mono text-xs leading-relaxed text-ocean-900 placeholder:text-ocean-700/35 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                          placeholder="<p>…</p>"
                        ></textarea>
                      </div>
                    ))
                  }
                </div>
              </fieldset>

              <!-- Aperçu -->
              <div>
                <p class="mb-1.5 text-sm font-medium text-ocean-800">
                  {AT['guide.previewTitle']} <span class="font-normal text-ocean-700/55">— {AT['guide.previewNote']}</span>
                </p>
                <iframe
                  id="guide-preview"
                  title={AT['guide.previewTitle']}
                  sandbox=""
                  class="h-44 w-full rounded-lg border border-sand-200 bg-white"
                ></iframe>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-ocean-800 mb-1.5" for="guide-ordre">
                    {AT['common.order']}
                  </label>
                  <input
                    id="guide-ordre"
                    type="number"
                    step="1"
                    value="0"
                    class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2 text-sm text-ocean-900 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                  />
                </div>
                <div class="flex items-end">
                  <label class="flex items-center gap-2 pb-2 text-sm text-ocean-800">
                    <input id="guide-actif" type="checkbox" checked class="h-4 w-4 rounded border-sand-300 text-ocean-600 focus:ring-ocean-200" />
                    {AT['common.active']}
                  </label>
                </div>
              </div>

              <p id="guide-form-error" class="hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700 ring-1 ring-rose-200"></p>

              <div class="flex flex-wrap items-center justify-end gap-2 border-t border-sand-200/70 pt-4">
                <button
                  id="guide-form-delete"
                  type="button"
                  class="hidden rounded-full border border-rose-200 bg-white px-4 py-2 text-sm font-medium text-rose-700 transition-colors hover:bg-rose-50"
                >
                  {AT['common.delete']}
                </button>
                <button
                  id="guide-form-cancel"
                  type="button"
                  class="rounded-full border border-sand-300 bg-white px-4 py-2 text-sm font-medium text-ocean-800 transition-colors hover:bg-sand-50"
                >
                  {AT['common.cancel']}
                </button>
                <button
                  type="submit"
                  class="rounded-full bg-sunset-500 px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-sunset-600 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  {AT['common.save']}
                </button>
              </div>
            </form>
          </div>
        </div>
      </>
    )
  }
</AdminLayout>

{
  configured && (
    <script>
      import { sb, CLS, esc, toast, errText } from '../../lib/admin-runtime';
      import { AT } from '../../i18n/admin';
      import type { GuideSection } from '../../lib/supabase';

      const LANGS = ['fr', 'en', 'es', 'de'] as const;

      let sections: GuideSection[] = [];
      let editingId: string | null = null;

      const listEl = document.getElementById('guide-list');
      const panel = document.getElementById('guide-form-panel');
      const formTitle = document.getElementById('guide-form-title');
      const form = document.getElementById('guide-form') as HTMLFormElement | null;
      const formError = document.getElementById('guide-form-error');
      const deleteBtn = document.getElementById('guide-form-delete');
      const countEl = document.getElementById('guide-count');
      const preview = document.getElementById('guide-preview') as HTMLIFrameElement | null;

      const val = (id: string) =>
        document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
      const showErr = (id: string, message: string) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = message;
        el.classList.toggle('hidden', !message);
      };

      // -----------------------------------------------------------------
      // Chargement
      // -----------------------------------------------------------------
      async function load() {
        const { data, error } = await sb()
          .from('guide_sections')
          .select('*')
          .order('ordre', { ascending: true });
        if (error) {
          toast(errText(error) || AT['common.errorGeneric'], 'error');
          return;
        }
        sections = (data ?? []) as GuideSection[];
        renderList();
      }

      function renderList() {
        if (!listEl) return;
        if (!sections.length) {
          listEl.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-sm text-ocean-700/60">${esc(AT['guide.empty'])}</td></tr>`;
        } else {
          listEl.innerHTML = sections
            .map((s) => {
              const titre = s.titre?.fr || Object.values(s.titre ?? {})[0] || '—';
              return `
              <tr class="transition-colors hover:bg-sand-50/70">
                <td class="px-4 py-3 align-top">
                  <button
                    type="button"
                    data-edit="${esc(s.id)}"
                    class="flex items-center gap-2 text-left text-sm font-semibold text-ocean-900 underline-offset-2 hover:text-ocean-600 hover:underline"
                  >
                    <span aria-hidden="true">${esc(s.icone || '📄')}</span>
                    <span>${esc(titre)}</span>
                  </button>
                </td>
                <td class="px-4 py-3 align-top text-xs text-ocean-700/60">${esc(s.slug)}</td>
                <td class="px-4 py-3 align-top text-sm text-ocean-700/80">${esc(String(s.ordre ?? 0))}</td>
                <td class="px-4 py-3 align-top">
                  <button
                    type="button"
                    data-toggle="${esc(s.id)}"
                    title="${esc(s.actif ? AT['common.deactivate'] : AT['common.activate'])}"
                    class="${
                      s.actif
                        ? 'bg-emerald-50 text-emerald-700 ring-emerald-200'
                        : 'bg-sand-100 text-ocean-700/70 ring-sand-300'
                    } ${CLS.badge} transition-colors hover:opacity-80"
                  >${esc(s.actif ? AT['common.active'] : AT['common.inactive'])}</button>
                </td>
                <td class="px-4 py-3 align-top">
                  <div class="flex items-center justify-end gap-1.5">
                    <button
                      type="button"
                      data-edit="${esc(s.id)}"
                      class="rounded-full border border-sand-300 bg-white px-3 py-1.5 text-xs font-medium text-ocean-800 transition-colors hover:bg-sand-50"
                    >${esc(AT['common.edit'])}</button>
                    <button
                      type="button"
                      data-remove="${esc(s.id)}"
                      class="rounded-full border border-rose-200 bg-white px-3 py-1.5 text-xs font-medium text-rose-700 transition-colors hover:bg-rose-50"
                    >${esc(AT['common.delete'])}</button>
                  </div>
                </td>
              </tr>`;
            })
            .join('');
        }
        if (countEl) countEl.textContent = `${sections.length} ${AT['guide.count']}`;
      }

      // -----------------------------------------------------------------
      // Aperçu (iframe isolée, sans script exécuté)
      // -----------------------------------------------------------------
      function renderPreview() {
        if (!preview) return;
        const html = (val('guide-contenu-fr')?.value ?? '').trim();
        const doc = `<!doctype html><html lang="fr"><head><meta charset="utf-8">
          <style>
            body{font-family:Inter,system-ui,sans-serif;color:#072836;margin:14px;font-size:14px;line-height:1.6}
            h1,h2,h3{font-family:Georgia,serif}
            p{margin:.6em 0} ul,ol{margin:.6em 0;padding-left:1.3em} li{margin:.25em 0}
            a{color:#15648a}
          </style></head><body>${html || `<p style="color:#9aa;font-style:italic">—</p>`}</body></html>`;
        preview.srcdoc = doc;
      }

      // -----------------------------------------------------------------
      // Formulaire
      // -----------------------------------------------------------------
      function openForm(section?: GuideSection) {
        editingId = section?.id ?? null;
        if (formTitle) formTitle.textContent = section ? AT['guide.editTitle'] : AT['guide.createTitle'];
        if (deleteBtn) deleteBtn.classList.toggle('hidden', !section);
        if (formError) formError.classList.add('hidden');
        showErr('err-gslug', '');
        showErr('err-gtitre', '');

        const id = val('guide-id');
        const slug = val('guide-slug');
        const icone = val('guide-icone');
        const ordre = val('guide-ordre');
        const actif = val('guide-actif');
        if (id) id.value = section?.id ?? '';
        if (slug) slug.value = section?.slug ?? '';
        if (icone) icone.value = section?.icone ?? '';
        if (ordre) ordre.value = section ? String(section.ordre) : '0';
        if (actif) actif.checked = section ? section.actif : true;

        for (const l of LANGS) {
          const titre = val(`guide-titre-${l}`);
          const contenu = val(`guide-contenu-${l}`);
          if (titre) titre.value = section?.titre?.[l] ?? '';
          if (contenu) contenu.value = section?.contenu?.[l] ?? '';
        }

        renderPreview();
        panel?.classList.remove('hidden');
        panel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function closeForm() {
        editingId = null;
        panel?.classList.add('hidden');
        form?.reset();
      }

      const slugify = (s: string) =>
        s
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        showErr('err-gslug', '');
        showErr('err-gtitre', '');
        if (formError) formError.classList.add('hidden');

        const slug = slugify(val('guide-slug')?.value ?? '');
        const titre: Record<string, string> = {};
        const contenu: Record<string, string> = {};
        for (const l of LANGS) {
          titre[l] = (val(`guide-titre-${l}`)?.value ?? '').trim();
          contenu[l] = (val(`guide-contenu-${l}`)?.value ?? '').trim();
        }
        const icone = (val('guide-icone')?.value ?? '').trim() || null;
        const ordre = Number(val('guide-ordre')?.value ?? 0);
        const actif = Boolean(val('guide-actif')?.checked);

        let invalid = false;
        if (!slug || !/^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) {
          showErr('err-gslug', AT['guide.slugInvalid']);
          invalid = true;
        }
        if (!titre.fr) {
          showErr('err-gtitre', AT['guide.titleRequired']);
          invalid = true;
        }
        if (invalid) return;

        const payload = {
          slug,
          titre,
          contenu,
          icone,
          ordre: Number.isFinite(ordre) ? ordre : 0,
          actif,
        };

        const { error } = editingId
          ? await sb().from('guide_sections').update(payload).eq('id', editingId)
          : await sb().from('guide_sections').insert(payload);

        if (error) {
          const message = errText(error);
          if (formError) {
            formError.textContent = message;
            formError.classList.remove('hidden');
          }
          toast(message || AT['common.errorGeneric'], 'error');
          return;
        }

        toast(AT['guide.saved']);
        closeForm();
        await load();
      });

      deleteBtn?.addEventListener('click', async () => {
        if (!editingId) return;
        if (!window.confirm(`${AT['guide.confirmDelete']} ${AT['common.irreversible']}`)) return;
        const { error } = await sb().from('guide_sections').delete().eq('id', editingId);
        if (error) {
          toast(errText(error) || AT['common.errorGeneric'], 'error');
          return;
        }
        toast(AT['guide.deleted']);
        closeForm();
        await load();
      });

      // Aperçu en direct pendant la saisie
      form?.addEventListener('input', (event) => {
        const target = event.target as HTMLElement;
        if (target instanceof HTMLTextAreaElement && target.dataset.lang === 'fr') renderPreview();
      });

      // -----------------------------------------------------------------
      // Interactions de la liste
      // -----------------------------------------------------------------
      listEl?.addEventListener('click', async (event) => {
        const target = event.target as HTMLElement;

        const editBtn = target.closest<HTMLElement>('[data-edit]');
        if (editBtn) {
          const section = sections.find((s) => s.id === editBtn.dataset.edit);
          if (section) openForm(section);
          return;
        }

        const toggleBtn = target.closest<HTMLElement>('[data-toggle]');
        if (toggleBtn) {
          const section = sections.find((s) => s.id === toggleBtn.dataset.toggle);
          if (!section) return;
          const { error } = await sb()
            .from('guide_sections')
            .update({ actif: !section.actif })
            .eq('id', section.id);
          if (error) {
            toast(errText(error) || AT['common.errorGeneric'], 'error');
            return;
          }
          toast(AT['guide.toggled']);
          await load();
          return;
        }

        const removeBtn = target.closest<HTMLElement>('[data-remove]');
        if (removeBtn) {
          const section = sections.find((s) => s.id === removeBtn.dataset.remove);
          if (!section) return;
          if (!window.confirm(`${AT['guide.confirmDelete']} ${AT['common.irreversible']}`)) return;
          const { error } = await sb().from('guide_sections').delete().eq('id', section.id);
          if (error) {
            toast(errText(error) || AT['common.errorGeneric'], 'error');
            return;
          }
          toast(AT['guide.deleted']);
          await load();
        }
      });

      document.getElementById('guide-new')?.addEventListener('click', () => openForm());
      document.getElementById('guide-form-close')?.addEventListener('click', closeForm);
      document.getElementById('guide-form-cancel')?.addEventListener('click', closeForm);

      void load();
    </script>
  )
}
