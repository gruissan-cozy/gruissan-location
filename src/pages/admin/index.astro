---
/**
 * /admin/ — écran de connexion (magic link) puis tableau de bord.
 *
 * La page gère elle-même ses deux états (requireAuth: false) : le layout
 * laisse le contenu visible, le script bascule entre formulaire et tableau
 * de bord selon la session.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isSupabaseConfigured } from '../../lib/supabase';
import { AT } from '../../i18n/admin';

const configured = isSupabaseConfigured;
const base = import.meta.env.BASE_URL ?? '/';

const CARDS = [
  {
    key: 'revenus',
    href: `${base}admin/revenus/`,
    icon: '€',
    title: AT['nav.revenus'],
    desc: AT['dash.cardRevenus'],
    statId: 'stat-ca',
  },
  {
    key: 'messages',
    href: `${base}admin/messages/`,
    icon: '✉',
    title: AT['nav.messages'],
    desc: AT['dash.cardMessages'],
    statId: 'stat-messages',
  },
  {
    key: 'disponibilites',
    href: `${base}admin/disponibilites/`,
    icon: '▦',
    title: AT['nav.dispo'],
    desc: AT['dash.cardDispo'],
    statId: 'stat-dispo',
  },
  {
    key: 'packs',
    href: `${base}admin/packs/`,
    icon: '✚',
    title: AT['nav.packs'],
    desc: AT['dash.cardPacks'],
    statId: 'stat-packs',
  },
  {
    key: 'guide',
    href: `${base}admin/guide/`,
    icon: '☰',
    title: AT['nav.guide'],
    desc: AT['dash.cardGuide'],
    statId: 'stat-guide',
  },
] as const;
---

<AdminLayout title={AT['nav.dashboard']} section="dashboard" requireAuth={false}>
  {
    !configured ? null : (
      <>
        <!-- ============ Écran de connexion ============ -->
        <section id="admin-login" class="mx-auto max-w-lg py-6">
          <div class="rounded-2xl border border-sand-200/70 bg-white p-7 shadow-card sm:p-9">
            <p class="text-3xl" aria-hidden="true">
              🔑
            </p>
            <h1 class="mt-3 font-display text-2xl font-semibold text-ocean-900">
              {AT['auth.loginTitle']}
            </h1>
            <p class="mt-2 text-sm leading-relaxed text-ocean-700/80">{AT['auth.loginSubtitle']}</p>

            <form id="login-form" class="mt-6 space-y-4" novalidate>
              <div>
                <label class="block text-sm font-medium text-ocean-800 mb-1.5" for="login-email">
                  {AT['auth.email']}
                </label>
                <input
                  id="login-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder={AT['auth.emailPlaceholder']}
                  class="w-full rounded-lg border border-sand-300 bg-white px-3 py-2.5 text-sm text-ocean-900 placeholder:text-ocean-700/35 focus:border-ocean-500 focus:ring-2 focus:ring-ocean-200 focus:outline-none transition"
                />
              </div>

              <p id="login-error" class="hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700 ring-1 ring-rose-200"></p>

              <button
                id="login-submit"
                type="submit"
                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-sunset-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-sunset-600 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {AT['auth.submit']}
              </button>
            </form>

            <!-- Message « vérifiez votre boîte mail » -->
            <div id="login-sent" class="mt-6 hidden rounded-xl border border-ocean-200 bg-ocean-50 p-5">
              <p class="font-display text-lg font-semibold text-ocean-800">
                {AT['auth.sentTitle']}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-ocean-800/85">
                {AT['auth.sentBody']} <strong id="login-sent-email" class="break-all"></strong>.
              </p>
              <p class="mt-2 text-sm leading-relaxed text-ocean-800/70">{AT['auth.sentHint']}</p>
              <button
                id="login-again"
                type="button"
                class="mt-4 rounded-full border border-ocean-300 bg-white px-4 py-2 text-sm font-medium text-ocean-800 transition-colors hover:bg-ocean-50"
              >
                {AT['auth.otherEmail']}
              </button>
            </div>
          </div>
        </section>

        <!-- ============ Tableau de bord ============ -->
        <section id="admin-dashboard" class="hidden">
          <header class="mb-7">
            <h1 class="font-display text-2xl font-semibold text-ocean-900 sm:text-3xl">
              {AT['dash.title']}
            </h1>
            <p class="mt-1.5 text-sm text-ocean-700/80">{AT['dash.subtitle']}</p>
          </header>

          <!-- Alerte : la migration du suivi lu / non lu n'est pas appliquée -->
          <div
            id="dash-migration-lu"
            class="mb-6 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-800"
            role="alert"
          >
            {AT['dash.migrationLuMissing']}
          </div>

          <!-- Alerte : la table des séjours n'existe pas encore (chantier 6) -->
          <div
            id="dash-ca-migration"
            class="mb-6 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-800"
            role="alert"
          >
            {AT['dash.migrationSejoursMissing']}
          </div>

          <!-- Compteurs -->
          <div class="mb-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
            <!-- Chiffre d'affaires : masqué tant que les séjours ne sont pas
                 chargés (la table peut ne pas exister). -->
            <div
              id="dash-card-ca"
              class="hidden rounded-2xl border border-sunset-200/70 bg-white p-5 shadow-card"
            >
              <p class="text-xs font-medium uppercase tracking-wide text-ocean-700/60">
                {AT['dash.statCa']}
              </p>
              <p id="stat-ca" class="mt-1 font-display text-3xl font-semibold text-sunset-500">—</p>
            </div>
            <div class="rounded-2xl border border-sunset-200/70 bg-white p-5 shadow-card">
              <p class="text-xs font-medium uppercase tracking-wide text-ocean-700/60">
                {AT['dash.statUnread']}
              </p>
              <p class="mt-1 flex items-center gap-2">
                <span
                  id="stat-unread"
                  data-non-lus-badge
                  class="mt-1 hidden h-6 min-w-6 items-center justify-center rounded-full bg-sunset-500 px-1.5 font-display text-sm font-semibold text-white"
                ></span>
                <span id="stat-unread-count" class="mt-1 font-display text-3xl font-semibold text-sunset-500">
                  —
                </span>
              </p>
              <p id="stat-unread-hint" class="mt-1 text-xs text-ocean-700/55"></p>
            </div>
            <div class="rounded-2xl border border-sand-200/70 bg-white p-5 shadow-card">
              <p class="text-xs font-medium uppercase tracking-wide text-ocean-700/60">
                {AT['dash.statNew']}
              </p>
              <p id="stat-new" class="mt-1 font-display text-3xl font-semibold text-sunset-500">—</p>
            </div>
            <div class="rounded-2xl border border-sand-200/70 bg-white p-5 shadow-card">
              <p class="text-xs font-medium uppercase tracking-wide text-ocean-700/60">
                {AT['dash.statTotal']}
              </p>
              <p id="stat-total" class="mt-1 font-display text-3xl font-semibold text-ocean-800">—</p>
            </div>
            <div class="rounded-2xl border border-sand-200/70 bg-white p-5 shadow-card">
              <p class="text-xs font-medium uppercase tracking-wide text-ocean-700/60">
                {AT['dash.statDispo']}
              </p>
              <p id="stat-dispo" class="mt-1 font-display text-3xl font-semibold text-ocean-800">—</p>
            </div>
            <div class="rounded-2xl border border-sand-200/70 bg-white p-5 shadow-card">
              <p class="text-xs font-medium uppercase tracking-wide text-ocean-700/60">
                {AT['dash.statPacks']}
              </p>
              <p id="stat-packs" class="mt-1 font-display text-3xl font-semibold text-ocean-800">—</p>
            </div>
          </div>

          <!-- Liens vers les 4 sections -->
          <div class="grid gap-4 sm:grid-cols-2">
            {
              CARDS.map((card) => (
                <a
                  href={card.href}
                  class="group rounded-2xl border border-sand-200/70 bg-white p-6 shadow-card transition-shadow hover:shadow-card-hover"
                >
                  <div class="flex items-start gap-4">
                    <span
                      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-ocean-50 text-lg text-ocean-600 ring-1 ring-ocean-100"
                      aria-hidden="true"
                    >
                      {card.icon}
                    </span>
                    <div class="min-w-0">
                      <h2 class="font-display text-lg font-semibold text-ocean-900 group-hover:text-ocean-600 transition-colors">
                        {card.title}
                      </h2>
                      <p class="mt-1 text-sm leading-relaxed text-ocean-700/75">{card.desc}</p>
                    </div>
                  </div>
                  <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-sunset-500">
                    {AT['dash.open']}
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
                      →
                    </span>
                  </p>
                </a>
              ))
            }
          </div>
        </section>
      </>
    )
  }
</AdminLayout>

<script>
  import { getSupabase } from '../../lib/supabase';
  import { errText, toast, majBadgeNonLus, fmtPrice } from '../../lib/admin-runtime';
  import { estErreurColonneLuAbsente } from '../../lib/lu';
  import { aggreger, estTableSejoursAbsente } from '../../lib/revenus';
  import type { Sejour } from '../../lib/supabase';
  import { AT } from '../../i18n/admin';

  const loginView = document.getElementById('admin-login');
  const dashView = document.getElementById('admin-dashboard');
  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('login-email') as HTMLInputElement | null;
  const submitBtn = document.getElementById('login-submit') as HTMLButtonElement | null;
  const errorBox = document.getElementById('login-error');
  const sentBox = document.getElementById('login-sent');
  const sentEmail = document.getElementById('login-sent-email');
  const againBtn = document.getElementById('login-again');

  const supabase = getSupabase();
  if (!supabase) {
    // Le layout affiche déjà le panneau « back office non configuré ».
  } else {
    // ---------- Bascule connexion / tableau de bord ----------
    const showLogin = () => {
      loginView?.classList.remove('hidden');
      dashView?.classList.add('hidden');
    };
    const showDashboard = () => {
      loginView?.classList.add('hidden');
      dashView?.classList.remove('hidden');
      loadStats();
    };

    // Seul cet email a le droit d'accéder au back office (le verrou
    // principal est côté base de données : politiques RLS).
    const ALLOWED_EMAIL = 'gruissancozy@gmail.com';

    const render = (session: { user?: { email?: string | null } | null } | null) => {
      if (session?.user?.email === ALLOWED_EMAIL) showDashboard();
      else if (session?.user) {
        // Session valide mais email non autorisé : on réutilise le panneau
        // « accès refusé » du layout, et on masque l'écran de connexion.
        loginView?.classList.add('hidden');
        dashView?.classList.add('hidden');
        document.getElementById('admin-auth-forbidden')?.classList.remove('hidden');
      } else showLogin();
    };

    supabase.auth.onAuthStateChange((_event, session) => render(session));
    supabase.auth.getSession().then(({ data }) => render(data.session));

    // ---------- Formulaire magic link ----------
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = (emailInput?.value ?? '').trim();

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (errorBox) {
          errorBox.textContent = AT['auth.invalidEmail'];
          errorBox.classList.remove('hidden');
        }
        emailInput?.focus();
        return;
      }
      if (errorBox) errorBox.classList.add('hidden');

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = AT['auth.sending'];
      }

      const base = import.meta.env.BASE_URL ?? '/';
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: {
          // Retour sur le tableau de bord après clic sur le lien reçu par mail.
          emailRedirectTo: `${window.location.origin}${base}admin/`,
        },
      });

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = AT['auth.submit'];
      }

      if (error) {
        if (errorBox) {
          errorBox.textContent = errText(error);
          errorBox.classList.remove('hidden');
        }
        toast(errText(error), 'error');
        return;
      }

      if (sentEmail) sentEmail.textContent = email;
      form?.classList.add('hidden');
      sentBox?.classList.remove('hidden');
    });

    againBtn?.addEventListener('click', () => {
      sentBox?.classList.add('hidden');
      form?.classList.remove('hidden');
      if (emailInput) {
        emailInput.value = '';
        emailInput.focus();
      }
    });

    // ---------- Compteurs du tableau de bord ----------
    const loaded = { done: false };
    async function loadStats() {
      if (loaded.done) return;
      // Le narrowing du `if (!supabase)` ci-dessus ne traverse pas les
      // fermetures : on revérifie ici pour garantir un client non nul.
      if (!supabase) return;
      loaded.done = true;

      const set = (id: string, value: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
      };
      const migrationEl = document.getElementById('dash-migration-lu');

      // Suivi lu / non lu (chantier 4 — #18) : la colonne `lu_at` n'existe
      // pas tant que la migration 0005 n'est pas appliquée. On tente la
      // requête dédiée ; en cas d'échec, on retombe sur le compteur des
      // demandes au statut « nouveau » et on affiche un bandeau explicite.
      const nonLus = supabase
        .from('messages')
        .select('id', { count: 'exact', head: true })
        .is('lu_at', null);

      try {
        const [total, nouveaux, dispo, packs, nonLues] = await Promise.all([
          supabase.from('messages').select('id', { count: 'exact', head: true }),
          supabase
            .from('messages')
            .select('id', { count: 'exact', head: true })
            .eq('statut', 'nouveau'),
          supabase.from('availability').select('id', { count: 'exact', head: true }),
          supabase.from('packs').select('id', { count: 'exact', head: true }).eq('actif', true),
          nonLus,
        ]);

        const firstError = [total, nouveaux, dispo, packs].find((r) => r.error);
        if (firstError?.error) throw firstError.error;

        set('stat-total', String(total.count ?? 0));
        set('stat-new', String(nouveaux.count ?? 0));
        set('stat-dispo', String(dispo.count ?? 0));
        set('stat-packs', String(packs.count ?? 0));

        // Suivi lu / non lu : en cas d'échec de la requête dédiée (colonne
        // absente), on retombe sur le compteur « nouveau » pour ne rien
        // casser, et on affiche un bandeau demandant la migration 0005.
        const nonLuesReelles = nonLues.error ? nouveaux.count ?? 0 : nonLues.count ?? 0;
        set('stat-unread-count', String(nonLuesReelles));
        majBadgeNonLus(nonLuesReelles);
        if (nonLues.error && estErreurColonneLuAbsente(nonLues.error) && migrationEl) {
          migrationEl.classList.remove('hidden');
        }

        const hint = document.getElementById('stat-unread-hint');
        if (hint) {
          hint.textContent = nonLuesReelles
            ? `${nonLuesReelles} ${AT['msg.unreadCount']} — ${AT['dash.unreadHint']}`
            : '';
        }

        // ---------- Chiffre d'affaires (chantier 6 — #20) ----------
        // Séparé du bloc ci-dessus : si la table `sejours` n'existe pas
        // encore, la carte reste masquée et les autres compteurs
        // s'affichent quand même.
        const resSejours = await supabase.from('sejours').select('*');
        if (resSejours.error) {
          if (estTableSejoursAbsente(resSejours.error)) {
            // Bandeau réutilisé : il nomme la migration 0003 à appliquer.
            document
              .getElementById('dash-ca-migration')
              ?.classList.remove('hidden');
          }
        } else {
          const sejours = (resSejours.data ?? []) as Sejour[];
          const ca = aggreger(sejours).total;
          set('stat-ca', fmtPrice(ca, true));
          document.getElementById('dash-card-ca')?.classList.remove('hidden');
        }
      } catch (error) {
        toast(errText(error) || AT['common.errorGeneric'], 'error');
      }
    }
  }
</script>
