---
/**
 * /admin/messages — liste des demandes, fil par statut, vue détail,
 * fil des réponses (colonne `replies`) et changement de statut.
 *
 * Pipeline de statuts (chantier 5 — #19) : nouveau → contacte →
 * devis_envoye → confirme → termine, plus « refuse ». La logique pure
 * (transitions autorisées, progression, comptage, historique) vit dans
 * `src/lib/pipeline.ts` (testée dans tests/pipeline.test.ts).
 *
 * Tant que la migration `migrations/0004_pipeline_statuts.sql` n'est pas
 * appliquée, les valeurs héritées s'affichent telles quelles et un
 * bandeau demande d'exécuter la migration : l'interface ne plante pas.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isSupabaseConfigured } from '../../lib/supabase';
import { AT } from '../../i18n/admin';
import { STATUTS_MESSAGE } from '../../lib/pipeline';

const configured = isSupabaseConfigured;
const STATUTS = STATUTS_MESSAGE;

const FILTERS = [
  { value: 'tous', label: AT['common.all'] },
  // Filtre « non lues » (chantier 4 — #18) : n'apporte rien tant que la
  // migration 0005 n'est pas appliquée, mais il est toujours affiché —
  // sa compteur tombe alors à zéro et le marquage affiche un bandeau.
  { value: 'non_lus', label: AT['msg.filterUnread'] },
  ...STATUTS.map((s) => ({ value: s, label: AT[`statut.${s}`] })),
] as const;
---

<AdminLayout title={AT['msg.title']} section="messages">
  {
    configured && (
      <>
        <header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h1 class="font-display text-2xl font-semibold text-ocean-900 sm:text-3xl">
              {AT['msg.title']}
            </h1>
            <p class="mt-1.5 text-sm text-ocean-700/80">{AT['msg.subtitle']}</p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <p id="msg-count" class="text-sm text-ocean-700/70"></p>
            <!-- Action groupée : tout marquer comme lu (chantier 4 — #18) -->
            <button
              id="msg-mark-all"
              type="button"
              class="hidden inline-flex items-center justify-center gap-2 rounded-full border border-sand-300 bg-white px-4 py-2 text-sm font-medium text-ocean-800 transition-colors hover:bg-sand-50"
            >
              {AT['msg.markAllRead']}
            </button>
          </div>
        </header>

        <!-- Alerte : la migration du pipeline n'est pas encore appliquée -->
        <div
          id="msg-migration"
          class="mb-5 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-800"
          role="alert"
        >
          {AT['msg.migrationMissing']}
        </div>

        <!-- Alerte : la migration du suivi lu / non lu n'est pas appliquée -->
        <div
          id="msg-migration-lu"
          class="mb-5 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-800"
          role="alert"
        >
          {AT['msg.migrationLuMissing']}
        </div>

        <!-- Filtres par statut + demandes non lues -->
        <div class="mb-5 flex flex-wrap gap-2" role="group" aria-label={AT['common.status']}>
          {
            FILTERS.map((f) => (
              <button
                type="button"
                data-filter={f.value}
                class="msg-filter rounded-full border border-sand-300 bg-white px-3.5 py-1.5 text-sm font-medium text-ocean-800 transition-colors hover:bg-sand-50"
              >
                {f.label}
                <span data-count={f.value} class="ml-1.5 text-xs text-ocean-700/50"></span>
              </button>
            ))
          }
        </div>

        <div class="grid gap-5 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
          <!-- ===== Liste ===== -->
          <div class="rounded-2xl border border-sand-200/70 bg-white shadow-card">
            <div id="msg-list" class="divide-y divide-sand-200/70">
              <p class="p-6 text-sm text-ocean-700/60">{AT['common.loading']}</p>
            </div>
          </div>

          <!-- ===== Détail ===== -->
          <div id="msg-detail" class="rounded-2xl border border-sand-200/70 bg-white shadow-card">
            <div id="msg-detail-empty" class="p-8 text-center text-sm text-ocean-700/60">
              {AT['msg.selectHint']}
            </div>
            <div id="msg-detail-body" class="hidden"></div>
          </div>
        </div>
      </>
    )
  }
</AdminLayout>

{
  configured && (
    <script>
      import { sb, CLS, MESSAGE_STATUT_CLS, esc, fmtDate, fmtDateTime, toast, errText, majBadgeNonLus } from '../../lib/admin-runtime';
      import { AT } from '../../i18n/admin';
      import {
        STATUTS_MESSAGE,
        transitionsAutorisees,
        estTransitionAutorisee,
        etapeSuivante,
        estStatutMessage,
        estValeurHeritee,
        compterParStatut,
        construireEntreeHistorique,
        avancerSiNecessaire,
      } from '../../lib/pipeline';
      import {
        compterNonLus,
        idsNonLus,
        appliquerLu,
        appliquerToutLu,
        trierParPriorite,
        estLue,
        patchLu,
        maintenantISO,
        colonneLuAbsente,
        estErreurColonneLuAbsente,
      } from '../../lib/lu';
      import type { Message } from '../../lib/supabase';

      const STATUTS = STATUTS_MESSAGE;

      let messages: Message[] = [];
      let activeFilter = 'tous';
      let selectedId: string | null = null;

      const listEl = document.getElementById('msg-list');
      const detailEl = document.getElementById('msg-detail-body');
      const emptyEl = document.getElementById('msg-detail-empty');
      const countEl = document.getElementById('msg-count');
      const migrationEl = document.getElementById('msg-migration');
      const migrationLuEl = document.getElementById('msg-migration-lu');
      const markAllBtn = document.getElementById('msg-mark-all');

      const statutLabel = (s: string) => AT[`statut.${s}`] ?? s;
      const badge = (s: string) =>
        `<span class="${CLS.badge} ${MESSAGE_STATUT_CLS[s] ?? 'bg-sand-100 text-ocean-700 ring-sand-300'}">${esc(statutLabel(s))}</span>`;
      const badgeLu = (lue: boolean) =>
        lue
          ? `<span class="${CLS.badge} bg-sand-100 text-ocean-700/70 ring-sand-300">${esc(AT['msg.read'])}</span>`
          : `<span class="${CLS.badge} bg-sunset-400/15 text-sunset-600 ring-sunset-400/40">${esc(AT['msg.unread'])}</span>`;

      /** Statut hérité non converti (ou valeur inconnue) : migration requise. */
      const statutIllisible = (s: string) => estValeurHeritee(s) || !estStatutMessage(s);

      // -----------------------------------------------------------------
      // Alertes « migration requise »
      // -----------------------------------------------------------------
      function afficherMigrationRequise() {
        if (migrationEl) migrationEl.classList.remove('hidden');
      }

      /**
       * Bandeau spécifique au suivi lu / non lu : la colonne `lu_at` est
       * absente tant que migrations/0005_demandes_lues.sql n'est pas
       * appliquée. On le montre dès le chargement (détection sur les
       * données) ou après une erreur d'écriture.
       */
      function afficherMigrationLu() {
        if (migrationLuEl) migrationLuEl.classList.remove('hidden');
      }

      /** Message d'erreur d'écriture : guide vers la migration si besoin. */
      function erreurEcriture(error: unknown): string {
        const brut = errText(error).toLowerCase();
        if (brut.includes('check') || brut.includes('constraint') || brut.includes('historique') || brut.includes('column')) {
          return AT['msg.migrationMissing'];
        }
        return errText(error) || AT['common.errorGeneric'];
      }

      // -----------------------------------------------------------------
      // Chargement
      // -----------------------------------------------------------------
      async function load() {
        const { data, error } = await sb()
          .from('messages')
          .select('*')
          .order('created_at', { ascending: false });

        if (error) {
          toast(errText(error) || AT['common.errorGeneric'], 'error');
          return;
        }
        messages = (data ?? []) as Message[];
        if (messages.some((m) => statutIllisible(m.statut))) afficherMigrationRequise();
        // Colonne `lu_at` absente → le suivi n'est pas possible.
        if (colonneLuAbsente(messages)) afficherMigrationLu();
        renderCounts();
        renderList();
        if (selectedId && !messages.some((m) => m.id === selectedId)) selectedId = null;
        renderDetail();
      }

      function renderCounts() {
        const compteurs = compterParStatut(messages, STATUTS);
        const nonLus = compterNonLus(messages);
        const afficher = (cle: string, n: number) => {
          const el = document.querySelector(`[data-count="${cle}"]`);
          if (el) el.textContent = n ? `(${n})` : '';
        };
        afficher('tous', messages.length);
        afficher('non_lus', nonLus);
        for (const s of STATUTS) afficher(s, compteurs[s] ?? 0);
        if (countEl) {
          countEl.textContent = messages.length
            ? `${messages.length} message${messages.length > 1 ? 's' : ''} · ${nonLus} ${AT['msg.unreadCount']}`
            : '';
        }
        // Le badge de navigation et l'action groupée suivent les non-lus.
        majBadgeNonLus(nonLus);
        if (markAllBtn) markAllBtn.classList.toggle('hidden', nonLus === 0);
        for (const btn of document.querySelectorAll<HTMLButtonElement>('.msg-filter')) {
          const value = btn.dataset.filter ?? 'tous';
          const on = value === activeFilter;
          btn.classList.toggle('bg-ocean-600', on);
          btn.classList.toggle('text-white', on);
          btn.classList.toggle('border-ocean-600', on);
          btn.classList.toggle('font-semibold', on);
          btn.classList.toggle('bg-white', !on);
          btn.classList.toggle('text-ocean-800', !on);
          btn.classList.toggle('border-sand-300', !on);
        }
      }

      function visibleMessages(): Message[] {
        let list: Message[];
        if (activeFilter === 'non_lus') {
          list = messages.filter((m) => !estLue(m));
        } else if (activeFilter === 'tous') {
          // Ordre de priorité : les demandes non lues d'abord.
          list = trierParPriorite(messages);
        } else {
          list = messages.filter((m) => m.statut === activeFilter);
        }
        return list;
      }

      // -----------------------------------------------------------------
      // Rendu de la liste
      // -----------------------------------------------------------------
      function renderList() {
        if (!listEl) return;
        const list = visibleMessages();

        if (!list.length) {
          listEl.innerHTML = `<p class="p-6 text-sm text-ocean-700/60">${
            messages.length ? esc(AT['msg.emptyFiltered']) : esc(AT['msg.empty'])
          }</p>`;
          return;
        }

        listEl.innerHTML = list
          .map((m) => {
            const isNew = m.statut === 'nouveau';
            const lue = estLue(m);
            const selected = m.id === selectedId;
            const suivante = etapeSuivante(m.statut);
            const peutRefuser = estTransitionAutorisee(m.statut, 'refuse');
            const illisible = statutIllisible(m.statut);
            return `
            <div class="px-4 py-3.5 ${selected ? 'bg-ocean-50' : ''}">
              <button
                type="button"
                data-msg-id="${esc(m.id)}"
                class="block w-full text-left transition-colors ${selected ? '' : 'rounded-xl hover:bg-sand-50'}"
              >
                <div class="flex items-start justify-between gap-2">
                  <span class="min-w-0">
                    <span class="flex flex-wrap items-center gap-1.5">
                      ${
                        !lue
                          ? '<span class="h-2 w-2 shrink-0 rounded-full bg-sunset-500" aria-hidden="true"></span>'
                          : ''
                      }
                      <span class="truncate text-sm font-semibold text-ocean-900">${esc(m.nom)}</span>
                      ${badgeLu(lue)}
                    </span>
                    <span class="mt-0.5 block truncate text-xs text-ocean-700/60">${esc(m.email)}</span>
                  </span>
                  ${badge(m.statut)}
                </div>
                <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-ocean-700/70">${esc(m.message)}</p>
                <p class="mt-2 flex flex-wrap items-center gap-2 text-xs text-ocean-700/45">
                  <span>${esc(fmtDate(m.created_at))}</span>
                  ${
                    isNew && lue
                      ? `<span>· ${esc(AT['msg.luAt'])} ${esc(fmtDateTime(m.lu_at))}</span>`
                      : ''
                  }
                  ${
                    Array.isArray(m.replies) && m.replies.length
                      ? `<span>· ${m.replies.length} ${esc(AT['msg.replyCount'])}</span>`
                      : ''
                  }
                </p>
              </button>

              <!-- Actions en un clic -->
              <div class="mt-2 flex flex-wrap items-center gap-2">
                ${
                  suivante
                    ? `<button type="button" data-advance="${esc(m.id)}" data-vers="${esc(suivante)}" class="${CLS.btnPrimary} ${CLS.btnSmall}">→ ${esc(statutLabel(suivante))}</button>`
                    : ''
                }
                ${
                  peutRefuser
                    ? `<button type="button" data-refuse="${esc(m.id)}" class="${CLS.btnDanger} ${CLS.btnSmall}">${esc(AT['msg.refuse'])}</button>`
                    : ''
                }
                <button
                  type="button"
                  data-lu="${esc(m.id)}"
                  data-vers="${lue ? 'non-lu' : 'lu'}"
                  class="${CLS.btnGhost} ${CLS.btnSmall}"
                >
                  ${esc(lue ? AT['msg.markUnread'] : AT['msg.markRead'])}
                </button>
                ${
                  illisible
                    ? `<span class="text-xs text-amber-700">${esc(AT['msg.unknownStatut'])}</span>`
                    : ''
                }
              </div>
            </div>`;
          })
          .join('');
      }

      // -----------------------------------------------------------------
      // Rendu du détail
      // -----------------------------------------------------------------
      function current(): Message | undefined {
        return messages.find((m) => m.id === selectedId);
      }

      function renderDetail() {
        if (!detailEl || !emptyEl) return;
        const m = current();
        if (!m) {
          detailEl.classList.add('hidden');
          detailEl.innerHTML = '';
          emptyEl.classList.remove('hidden');
          emptyEl.textContent = messages.length ? AT['msg.selectHint'] : AT['msg.empty'];
          return;
        }
        emptyEl.classList.add('hidden');
        detailEl.classList.remove('hidden');

        const replies = Array.isArray(m.replies) ? m.replies : [];
        const timeline = replies.length
          ? replies
              .slice()
              .sort((a, b) => String(a.at).localeCompare(String(b.at)))
              .map(
                (r) => `
              <li class="relative pl-6">
                <span class="absolute left-0 top-1.5 h-2.5 w-2.5 rounded-full bg-sunset-400 ring-4 ring-sunset-400/15" aria-hidden="true"></span>
                <p class="text-xs text-ocean-700/55">
                  ${esc(fmtDateTime(r.at))} · ${esc(r.by === 'admin' ? AT['msg.byAdmin'] : r.by)}
                </p>
                <p class="mt-1 whitespace-pre-line rounded-xl rounded-tl-none bg-sand-50 px-3.5 py-2.5 text-sm leading-relaxed text-ocean-900 ring-1 ring-sand-200/70">${esc(r.body)}</p>
              </li>`,
              )
              .join('')
          : `<li class="pl-6 text-sm text-ocean-700/55">${esc(AT['msg.repliesEmpty'])}</li>`;

        // Historique des changements de statut (colonne `historique`)
        const historique = Array.isArray(m.historique) ? m.historique : [];
        const history = historique.length
          ? historique
              .slice()
              .sort((a, b) => String(a.at).localeCompare(String(b.at)))
              .map(
                (h) => `
              <li class="relative pl-6">
                <span class="absolute left-0 top-1.5 h-2.5 w-2.5 rounded-full bg-ocean-400 ring-4 ring-ocean-400/15" aria-hidden="true"></span>
                <p class="text-xs text-ocean-700/55">${esc(fmtDateTime(h.at))}</p>
                <p class="mt-0.5 text-sm font-medium text-ocean-900">${esc(h.detail ?? h.action)}</p>
              </li>`,
              )
              .join('')
          : `<li class="pl-6 text-sm text-ocean-700/55">${esc(AT['msg.historyEmpty'])}</li>`;

        // Statuts proposés : statut courant + transitions autorisées
        const options = [...new Set([m.statut, ...transitionsAutorisees(m.statut)])];
        const illisible = statutIllisible(m.statut);
        const lue = estLue(m);

        detailEl.innerHTML = `
          <!-- En-tête -->
          <div class="flex flex-wrap items-start justify-between gap-3 border-b border-sand-200/70 px-5 py-4 sm:px-6">
            <div class="min-w-0">
              <h2 class="font-display text-lg font-semibold text-ocean-900">${esc(m.nom)}</h2>
              <p class="mt-0.5 text-xs text-ocean-700/60">
                ${esc(AT['msg.received'])} ${esc(fmtDateTime(m.created_at))}
              </p>
              <p class="mt-0.5 text-xs text-ocean-700/60">
                ${
                  lue
                    ? `${esc(AT['msg.luAt'])} ${esc(fmtDateTime(m.lu_at))}`
                    : esc(AT['msg.unread'])
                }
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              ${badgeLu(lue)}
              ${badge(m.statut)}
              <button
                type="button"
                id="msg-lu"
                data-lu="${esc(m.id)}"
                data-vers="${lue ? 'non-lu' : 'lu'}"
                class="${CLS.btnGhost} ${CLS.btnSmall}"
              >
                ${esc(lue ? AT['msg.markUnread'] : AT['msg.markRead'])}
              </button>
              <button
                type="button"
                id="msg-back"
                class="${CLS.btnGhost} ${CLS.btnSmall} lg:hidden"
              >${esc(AT['msg.back'])}</button>
            </div>
          </div>

          <div class="space-y-6 px-5 py-5 sm:px-6">
            <!-- Coordonnées -->
            <dl class="grid gap-3 sm:grid-cols-2">
              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-ocean-700/55">${esc(AT['auth.email'])}</dt>
                <dd class="mt-0.5 text-sm break-all">
                  <a class="text-ocean-600 underline-offset-2 hover:underline" href="mailto:${esc(m.email)}">${esc(m.email)}</a>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-ocean-700/55">${esc(AT['msg.phone'])}</dt>
                <dd class="mt-0.5 text-sm">
                  ${
                    m.telephone
                      ? `<a class="text-ocean-600 underline-offset-2 hover:underline" href="tel:${esc(m.telephone.replace(/\s/g, ''))}">${esc(m.telephone)}</a>`
                      : esc(AT['common.empty'])
                  }
                </dd>
              </div>
              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-ocean-700/55">${esc(AT['msg.dates'])}</dt>
                <dd class="mt-0.5 text-sm">${esc(m.dates || AT['common.empty'])}</dd>
              </div>
              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-ocean-700/55">${esc(AT['common.status'])}</dt>
                <dd class="mt-1">
                  <select id="msg-statut" class="${CLS.select} sm:max-w-[12rem]">
                    ${options
                      .map(
                        (s) =>
                          `<option value="${esc(s)}" ${s === m.statut ? 'selected' : ''}>${esc(statutLabel(s))}</option>`,
                      )
                      .join('')}
                  </select>
                  ${
                    illisible
                      ? `<p class="mt-1.5 text-xs text-amber-700">${esc(AT['msg.unknownStatut'])}</p>`
                      : ''
                  }
                </dd>
              </div>
            </dl>

            <!-- Message reçu -->
            <div>
              <h3 class="text-xs font-medium uppercase tracking-wide text-ocean-700/55">${esc(AT['msg.message'])}</h3>
              <p class="mt-1.5 whitespace-pre-line rounded-xl bg-sand-50 px-4 py-3 text-sm leading-relaxed text-ocean-900 ring-1 ring-sand-200/70">${esc(m.message)}</p>
            </div>

            <!-- Historique du pipeline -->
            <div>
              <h3 class="text-xs font-medium uppercase tracking-wide text-ocean-700/55">
                ${esc(AT['msg.historyTitle'])} <span class="normal-case tracking-normal">(${historique.length})</span>
              </h3>
              <ol class="mt-3 space-y-4 border-l border-sand-200 pl-4">
                ${history}
              </ol>
            </div>

            <!-- Fil des réponses -->
            <div>
              <h3 class="text-xs font-medium uppercase tracking-wide text-ocean-700/55">
                ${esc(AT['msg.replies'])} <span class="normal-case tracking-normal">(${replies.length})</span>
              </h3>
              <ol class="mt-3 space-y-4 border-l border-sand-200 pl-4">
                ${timeline}
              </ol>
            </div>

            <!-- Composer une réponse -->
            <form id="reply-form" class="rounded-xl border border-sand-200/70 bg-sand-50/60 p-4">
              <label class="${CLS.label}" for="reply-body">${esc(AT['msg.replyPlaceholder'])}</label>
              <textarea
                id="reply-body"
                rows="4"
                class="${CLS.textarea}"
                placeholder="${esc(AT['msg.replyPlaceholder'])}"
              ></textarea>
              <label class="mt-3 flex items-center gap-2 text-sm text-ocean-800">
                <input id="reply-mark" type="checkbox" checked class="${CLS.checkbox}" />
                ${esc(AT['msg.replyMark'])}
              </label>
              <p id="reply-error" class="mt-2 hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700 ring-1 ring-rose-200"></p>
              <div class="mt-3 flex justify-end">
                <button type="submit" class="${CLS.btnPrimary}">${esc(AT['msg.replySend'])}</button>
              </div>
            </form>
          </div>
        `;

        document.getElementById('msg-back')?.addEventListener('click', () => {
          detailEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        // Marquer lu / non lu depuis la vue détaillée.
        document.getElementById('msg-lu')?.addEventListener('click', () => {
          const btn = document.getElementById('msg-lu') as HTMLButtonElement | null;
          const id = btn?.dataset.lu;
          const vers = btn?.dataset.vers;
          if (id && (vers === 'lu' || vers === 'non-lu')) void updateLu(id, vers);
        });

        document.getElementById('msg-statut')?.addEventListener('change', async (event) => {
          const vers = (event.target as HTMLSelectElement).value;
          await updateStatut(m.id, vers);
        });

        document.getElementById('reply-form')?.addEventListener('submit', async (event) => {
          event.preventDefault();
          const body = (document.getElementById('reply-body') as HTMLTextAreaElement).value.trim();
          const errorBox = document.getElementById('reply-error');
          if (!body) {
            if (errorBox) {
              errorBox.textContent = AT['msg.replyEmpty'];
              errorBox.classList.remove('hidden');
            }
            return;
          }
          if (errorBox) errorBox.classList.add('hidden');

          const markRepondu = (document.getElementById('reply-mark') as HTMLInputElement).checked;
          const reply = { at: new Date().toISOString(), by: 'admin', body };
          const nextReplies = [...(Array.isArray(m.replies) ? m.replies : []), reply];

          // « Marqué comme contacté » : avance à `contacte` sans jamais régresser.
          const nouveauStatut = markRepondu ? avancerSiNecessaire(m.statut, 'contacte') : null;
          const entree = nouveauStatut ? construireEntreeHistorique(m.statut, nouveauStatut, reply.at) : null;
          const nextHistorique = [
            ...(Array.isArray(m.historique) ? m.historique : []),
            ...(entree ? [entree] : []),
          ];

          // Une réponse implique que la demande a été lue : on pose lu_at
          // en même temps (sans cela, elle resterait « non lue »).
          const patch: {
            replies: Message['replies'];
            statut?: string;
            historique?: Message['historique'];
            lu_at?: string | null;
          } = {
            replies: nextReplies,
            lu_at: reply.at,
          };
          if (nouveauStatut) {
            patch.statut = nouveauStatut;
            patch.historique = nextHistorique;
          }

          const { error } = await sb().from('messages').update(patch).eq('id', m.id);

          if (error) {
            if (estErreurColonneLuAbsente(error)) afficherMigrationLu();
            toast(
              estErreurColonneLuAbsente(error) ? AT['msg.migrationLuMissing'] : erreurEcriture(error),
              'error',
            );
            afficherMigrationRequise();
            return;
          }

          m.replies = nextReplies;
          m.lu_at = reply.at;
          if (nouveauStatut) {
            m.statut = nouveauStatut;
            m.historique = nextHistorique;
          }
          toast(AT['msg.replySent']);
          renderCounts();
          renderList();
          renderDetail();
        });
      }

      // -----------------------------------------------------------------
      // Écritures
      // -----------------------------------------------------------------
      async function updateStatut(id: string, vers: string) {
        const m = messages.find((x) => x.id === id);
        if (!m) return;
        const depuis = m.statut;
        if (depuis === vers) return;

        const entree = construireEntreeHistorique(depuis, vers, new Date().toISOString());
        const nextHistorique = [...(Array.isArray(m.historique) ? m.historique : []), entree];

        const { error } = await sb()
          .from('messages')
          .update({ statut: vers, historique: nextHistorique })
          .eq('id', id);

        if (error) {
          toast(erreurEcriture(error), 'error');
          afficherMigrationRequise();
          renderDetail();
          return;
        }

        m.statut = vers;
        m.historique = nextHistorique;
        toast(AT['msg.statusUpdated']);
        renderCounts();
        renderList();
        renderDetail();
      }

      /**
       * Marque une demande lue (`vers = 'lu'`) ou non lue (`vers = 'non-lu'`).
       * Persiste en base via la colonne `lu_at` (migration 0005). Si la
       * colonne est absente, on affiche le bandeau « migration requise »
       * et on laisse l'état local inchangé.
       */
      async function updateLu(id: string, vers: 'lu' | 'non-lu') {
        const m = messages.find((x) => x.id === id);
        if (!m) return;
        if (vers === 'lu' && estLue(m)) return;
        if (vers === 'non-lu' && !estLue(m)) return;

        const at = vers === 'lu' ? maintenantISO() : null;
        const { error } = await sb().from('messages').update(patchLu(at)).eq('id', id);

        if (error) {
          if (estErreurColonneLuAbsente(error)) afficherMigrationLu();
          toast(
            estErreurColonneLuAbsente(error) ? AT['msg.migrationLuMissing'] : erreurEcriture(error),
            'error',
          );
          renderDetail();
          return;
        }

        messages = appliquerLu(messages, id, at);
        toast(vers === 'lu' ? AT['msg.markedRead'] : AT['msg.markedUnread']);
        renderCounts();
        renderList();
        renderDetail();
      }

      /** Action groupée : marque toutes les demandes non lues comme lues. */
      async function toutMarquerLu() {
        const cibles = idsNonLus(messages);
        if (!cibles.length) return;
        if (!window.confirm(AT['msg.markAllReadConfirm'])) return;

        const at = maintenantISO();
        const { error } = await sb()
          .from('messages')
          .update(patchLu(at))
          .in('id', cibles);

        if (error) {
          if (estErreurColonneLuAbsente(error)) afficherMigrationLu();
          toast(
            estErreurColonneLuAbsente(error) ? AT['msg.migrationLuMissing'] : erreurEcriture(error),
            'error',
          );
          renderDetail();
          return;
        }

        messages = appliquerToutLu(messages, at);
        toast(AT['msg.allMarkedRead']);
        renderCounts();
        renderList();
        renderDetail();
      }

      // -----------------------------------------------------------------
      // Interactions
      // -----------------------------------------------------------------
      document.querySelectorAll<HTMLButtonElement>('.msg-filter').forEach((btn) => {
        btn.addEventListener('click', () => {
          activeFilter = btn.dataset.filter ?? 'tous';
          renderCounts();
          renderList();
        });
      });

      // Action groupée « tout marquer comme lu ».
      markAllBtn?.addEventListener('click', () => void toutMarquerLu());

      listEl?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;

        // Marquer lu / non lu (chantier 4 — #18) : le bouton porte
        // data-lu + data-vers, y compris dans la vue détaillée.
        const luBtn = target.closest<HTMLButtonElement>('[data-lu]');
        if (luBtn) {
          const id = luBtn.dataset.lu;
          const vers = luBtn.dataset.vers;
          if (id && (vers === 'lu' || vers === 'non-lu')) void updateLu(id, vers);
          return;
        }

        const advanceBtn = target.closest<HTMLButtonElement>('[data-advance]');
        if (advanceBtn) {
          const id = advanceBtn.dataset.advance;
          const vers = advanceBtn.dataset.vers;
          if (id && vers) void updateStatut(id, vers);
          return;
        }

        const refuseBtn = target.closest<HTMLButtonElement>('[data-refuse]');
        if (refuseBtn) {
          const id = refuseBtn.dataset.refuse;
          if (id) void updateStatut(id, 'refuse');
          return;
        }

        const info = target.closest<HTMLButtonElement>('[data-msg-id]');
        if (!info) return;
        selectedId = info.dataset.msgId ?? null;
        renderList();
        renderDetail();
        if (window.matchMedia('(max-width: 1023px)').matches) {
          detailEl?.parentElement?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });

      void load();
    </script>
  )
}
